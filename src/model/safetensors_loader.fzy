use core.env;
use core.io;
use model;
struct TensorDescriptor {
    name: str, dtype: str, rank: i32, dim0: i32, dim1: i32, raw: str, raw_start: i32, raw_end: i32, value_start: i32,
}
struct TensorArchive {
    format: str, tensor_count: i32, archive_path: str, raw: str, descriptors: ListHandle,
}
fn null_descriptor() -> TensorDescriptor {
    return TensorDescriptor {
        name: "", dtype: "", rank: 0, dim0: 0, dim1: 0, raw: "", raw_start: 0, raw_end: 0, value_start: 0,
    }
}
fn load(model_dir: str, _shape: model.EngineShape) -> TensorArchive {
    let archive_path = model.artifacts.weights_text_cache_path(model_dir) let index_path = str.concat(archive_path, ".index") trace_loader("archive_read_begin") let raw = if io.exists(archive_path) == 1 {
        io.read_text(archive_path)
    } else {
        ""
    }
    trace_loader("archive_read_done") let descriptors = load_descriptor_records(index_path, raw) trace_loader("archive_descriptors_ready") return TensorArchive {
        format: "fpa_text_v1", tensor_count: list.len(descriptors), archive_path: archive_path, raw: raw, descriptors: descriptors,
    }
}
fn load_descriptor_records(index_path: str, raw: str) -> ListHandle {
    if io.exists(index_path) == 1 {
        trace_loader("archive_index_hit") return parse_descriptor_records(io.read_text(index_path))
    }
    trace_loader("archive_index_miss") let built = parse_descriptors(raw) discard io.write_text(index_path, join_descriptor_records(built)) return built
}
fn find(archive: TensorArchive, name: str) -> TensorDescriptor {
    let mut idx = 0 while idx < archive.tensor_count {
        let desc = descriptor_at(archive, idx) if desc.name == name {
            return desc
        }
        idx = idx + 1
    }
    return null_descriptor()
}
fn read_1d(archive: TensorArchive, name: str, index: i32) -> i32 {
    let desc = find(archive, name) if desc.dim0 <= 0 {
        return 0
    }
    return read_desc_1d(desc, index)
}
fn read_2d(archive: TensorArchive, name: str, row: i32, col: i32) -> i32 {
    let desc = find(archive, name) if desc.dim0 <= 0 || desc.dim1 <= 0 {
        return 0
    }
    return read_desc_2d(desc, row, col)
}
fn descriptor_at(archive: TensorArchive, index: i32) -> TensorDescriptor {
    if index < 0 || index >= archive.tensor_count {
        return null_descriptor()
    }
    return descriptor_from_record(archive.raw, list.get(archive.descriptors, index))
}
fn parse_descriptors(raw: str) -> ListHandle {
    let descriptors = list.new() if raw == "" {
        return descriptors
    }
    let mut line_start = 0 let mut field_start = 0 let mut field_index = 0 let mut name = "" let mut dtype = "" let mut rank = "" let mut dim0 = "" let mut dim1 = "" let mut value_start = - 1 let mut idx = 0 while idx <= str.len(raw) {
        let at_end = idx == str.len(raw) let at_tab = if at_end {
            0
        } else if str.slice(raw, idx, idx + 1) == "\t" {
            1
        } else {
            0
        }
        let at_newline = if at_end {
            0
        } else if str.slice(raw, idx, idx + 1) == "\n" {
            1
        } else {
            0
        }
        if at_end || at_tab == 1 || at_newline == 1 {
            if field_index == 0 {
                name = str.slice(raw, field_start, idx)
            } else if field_index == 1 {
                dtype = str.slice(raw, field_start, idx)
            } else if field_index == 2 {
                rank = str.slice(raw, field_start, idx)
            } else if field_index == 3 {
                dim0 = str.slice(raw, field_start, idx)
            } else if field_index == 4 {
                dim1 = str.slice(raw, field_start, idx)
            } else if field_index == 5 {
                value_start = field_start
            }
            if at_end || at_newline == 1 {
                if idx > line_start {
                    discard list.push(descriptors, str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(name, "\t"), str.concat(dtype, "\t")), str.concat(rank, "\t")), str.concat(dim0, "\t")), str.concat(dim1, "\t")), str.concat(str.from_i32(line_start), "\t")), str.concat(str.from_i32(idx), "\t")), str.from_i32(value_start)))
                }
                line_start = idx + 1 field_start = idx + 1 field_index = 0 name = "" dtype = "" rank = "" dim0 = "" dim1 = "" value_start = - 1
            } else {
                field_index = field_index + 1 field_start = idx + 1
            }
        }
        idx = idx + 1
    }
    return descriptors
}
fn parse_descriptor_records(raw: str) -> ListHandle {
    let records = list.new() if raw == "" {
        return records
    }
    let mut start = 0 let mut idx = 0 while idx <= str.len(raw) {
        if idx == str.len(raw) || str.slice(raw, idx, idx + 1) == "\n" {
            if idx > start {
                discard list.push(records, str.slice(raw, start, idx))
            }
            start = idx + 1
        }
        idx = idx + 1
    }
    return records
}
fn join_descriptor_records(records: ListHandle) -> str {
    let mut out = "" let mut idx = 0 while idx < list.len(records) {
        if idx > 0 {
            out = str.concat(out, "\n")
        }
        out = str.concat(out, list.get(records, idx)) idx = idx + 1
    }
    return out
}
fn descriptor_from_record(raw: str, record: str) -> TensorDescriptor {
    return TensorDescriptor {
        name: field_at(record, 0), dtype: field_at(record, 1), rank: model.artifacts.parse_i32(field_at(record, 2)), dim0: model.artifacts.parse_i32(field_at(record, 3)), dim1: model.artifacts.parse_i32(field_at(record, 4)), raw: raw, raw_start: model.artifacts.parse_i32(field_at(record, 5)), raw_end: model.artifacts.parse_i32(field_at(record, 6)), value_start: model.artifacts.parse_i32(field_at(record, 7)),
    }
}
fn field_at(raw: str, position: i32) -> str {
    if raw == "" || position < 0 {
        return ""
    }
    let mut current = 0 let mut start = 0 let mut idx = 0 while idx <= str.len(raw) {
        if idx == str.len(raw) || str.slice(raw, idx, idx + 1) == "\t" {
            if current == position {
                return str.slice(raw, start, idx)
            }
            current = current + 1 start = idx + 1
        }
        idx = idx + 1
    }
    return ""
}
fn field_start_at(raw: str, position: i32) -> i32 {
    if raw == "" || position < 0 {
        return - 1
    }
    let mut current = 0 let mut start = 0 let mut idx = 0 while idx <= str.len(raw) {
        if idx == str.len(raw) || str.slice(raw, idx, idx + 1) == "\t" {
            if current == position {
                return start
            }
            current = current + 1 start = idx + 1
        }
        idx = idx + 1
    }
    return - 1
}
fn values_wire(desc: TensorDescriptor) -> str {
    if desc.value_start < 0 || desc.raw == "" || desc.raw_end <= desc.value_start {
        return ""
    }
    return str.slice(desc.raw, desc.value_start, desc.raw_end)
}
fn value_at(values_wire: str, position: i32) -> i32 {
    if position < 0 || values_wire == "" {
        return 0
    }
    let mut current = 0 let mut start = 0 let mut idx = 0 while idx <= str.len(values_wire) {
        if idx == str.len(values_wire) || str.slice(values_wire, idx, idx + 1) == "|" {
            if current == position {
                return model.artifacts.parse_i32(str.slice(values_wire, start, idx))
            }
            current = current + 1 start = idx + 1
        }
        idx = idx + 1
    }
    return 0
}
fn read_desc_1d(desc: TensorDescriptor, index: i32) -> i32 {
    if desc.dim0 <= 0 {
        return 0
    }
    return value_at(values_wire(desc), positive_mod(index, desc.dim0))
}
fn read_desc_2d(desc: TensorDescriptor, row: i32, col: i32) -> i32 {
    if desc.dim0 <= 0 || desc.dim1 <= 0 {
        return 0
    }
    let safe_row = positive_mod(row, desc.dim0) let safe_col = positive_mod(col, desc.dim1) return value_at(values_wire(desc), (safe_row * desc.dim1) + safe_col)
}
fn positive_mod(value: i32, modulo: i32) -> i32 {
    if modulo <= 0 {
        return 0
    }
    let raw = value% modulo if raw < 0 {
        return raw + modulo
    }
    return raw
}
fn trace_loader(label: str) {
    if env.get("FPA_TRACE_RUNTIME") == "1" {
        discard term.write(str.concat(str.concat("FPA_TRACE_ARCHIVE ", label), "\n"))
    }
}
