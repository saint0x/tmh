    out = str.concat(out, str.from_i32(aggregate.contains_target_count))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.matching_tokens))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.total_tokens))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.top1_agreement_pct))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_effective_bytes_per_token))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_block_remaps_per_sample))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_old_pages_streamed))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_raw_pages_streamed))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_ttft_ms))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_latency_ms))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_tokens_per_sec))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate.avg_steady_tokens_per_sec))
    return out
}
