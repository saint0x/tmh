use core.env;
use core.fs;
use core.io;
use core.path;
use core.proc;
use core.process;
use bench.metrics;
use bench.stress_suite;
use model;
use runtime.decode_loop;
fn trace_enabled() -> i32 {
    if env.get("FPA_TRACE_RUNTIME") == "1" {
        return 1
    }
    return 0
}
fn trace_line(label: str) {
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE ", label), "\n"))
    }
}
fn bench_budget_bundle_payload(raw: str) -> str {
    return tagged_frame_payload(raw, "FPA_BENCH_BUDGET ")
}
fn bench_limit(total: i32) -> i32 {
    let raw = env.get("FPA_BENCH_LIMIT") if raw == "" {
        return total
    }
    let parsed = model.artifacts.parse_i32(raw) if parsed <= 0 {
        return total
    }
    if parsed < total {
        return parsed
    }
    return total
}
fn bench_offset(total: i32) -> i32 {
    let raw = env.get("FPA_BENCH_OFFSET")
    if raw == "" {
        return 0
    }
    let parsed = model.artifacts.parse_i32(raw)
    if parsed <= 0 {
        return 0
    }
    if parsed >= total {
        return total
    }
    return parsed
}
fn bench_budget_timeout_ms(model_dir: str) -> i32 {
    let configured = env.get("FPA_BENCH_TIMEOUT_MS")
    if configured != "" {
        let parsed = model.artifacts.parse_i32(configured)
        if parsed > 0 {
            return parsed
        }
    }
    let suite_size = bench_limit(bench.stress_suite.count(bench.stress_suite.selected_suite_wire(model_dir)))
    let scaled = suite_size * 10000
    if scaled < 300000 {
        return 300000
    }
    return scaled
}
fn smoke_profile_enabled(model_dir: str) -> i32 {
    let profile = env.get("FPA_BENCH_PROFILE")
    if profile == "smoke" {
        return 1
    }
    if profile == "full" {
        return 0
    }
    return 0
}
struct PolicyAggregate {
    policy_name: str, sample_count: i32, exact_match_count: i32, contains_target_count: i32, matching_tokens: i32, total_tokens: i32, top1_agreement_pct: i32, avg_effective_bytes_per_token: i32, avg_block_remaps_per_sample: i32, avg_old_pages_streamed: i32, avg_raw_pages_streamed: i32, avg_ttft_ms: i32, avg_latency_ms: i32, avg_tokens_per_sec: i32, avg_steady_tokens_per_sec: i32,
}
struct BenchmarkReport {
    budget_label: str, hot_budget_pct: i32, suite_size: i32, full_kv: PolicyAggregate, paged_full_kv: PolicyAggregate, recent_only: PolicyAggregate, quantized_old_kv: PolicyAggregate, fidelity_paged_kv: PolicyAggregate,
}
struct SampleRow {
    budget_label: str, hot_budget_pct: i32, sample_id: str, category: str, policy_name: str, prompt_text: str, target_hint: str, prompt_token_count: i32, generated_tokens: i32, generated_text: str, generated_token_ids_wire: str, baseline_generated_text: str, baseline_generated_token_ids_wire: str, exact_match: i32, contains_target: i32, matching_tokens: i32, total_tokens: i32, top1_agreement_pct: i32, edit_distance: i32, effective_bytes_total: i32, block_remap_count_total: i32, copy_on_write_count_total: i32, old_pages_streamed_total: i32, raw_pages_streamed_total: i32, parity_match: i32, ttft_ms: i32, latency_ms: i32, tokens_per_sec: i32, steady_tokens_per_sec: i32,
}
struct BenchmarkArtifacts {
    report: BenchmarkReport, sample_rows_wire: str, failure_rows_wire: str,
}
struct BenchmarkMatrixArtifacts {
    budget_count: i32, budget_reports_wire: str, sample_rows_wire: str, failure_rows_wire: str,
}
struct FrameRead {
    value: str, next_idx: i32,
}
fn decimal_digit(ch: str) -> i32 {
    if ch == "0" {
        return 0
    }
    if ch == "1" {
        return 1
    }
    if ch == "2" {
        return 2
    }
    if ch == "3" {
        return 3
    }
    if ch == "4" {
        return 4
    }
    if ch == "5" {
        return 5
    }
    if ch == "6" {
        return 6
    }
    if ch == "7" {
        return 7
    }
    if ch == "8" {
        return 8
    }
    if ch == "9" {
        return 9
    }
    return - 1
}
fn parse_decimal(raw: str) -> i32 {
    if raw == "" {
        return 0
    }
    let mut sign = 1 let mut idx = 0 if str.slice(raw, 0, 1) == "-" {
        sign = - 1 idx = 1
    }
    let mut value = 0 while idx < str.len(raw) {
        let digit = decimal_digit(str.slice(raw, idx, idx + 1)) if digit < 0 {
            return sign * value
        }
        value = (value * 10) + digit idx = idx + 1
    }
    return sign * value
}
fn take_chars(raw: str, start: i32, count: i32) -> str {
    if count <= 0 {
        return ""
    }
    let mut idx = start let mut taken = 0 let mut out = "" while idx < str.len(raw) && taken < count {
        out = str.concat(out, str.slice(raw, idx, idx + 1)) idx = idx + 1 taken = taken + 1
    }
    return out
}
fn line_payload(raw: str, prefix: str) -> str {
    let start = model.artifacts.find_substring(raw, prefix)
    if start < 0 {
        return ""
    }
    let value_start = start + str.len(prefix)
    let mut value_end = value_start
    while value_end < str.len(raw) {
        if str.slice(raw, value_end, value_end + 1) == "\n" {
            break
        }
        value_end = value_end + 1
    }
    return str.slice(raw, value_start, value_end)
}
fn tagged_frame_payload(raw: str, prefix: str) -> str {
    let start = model.artifacts.find_substring(raw, prefix)
    if start < 0 {
        return ""
    }
    return frame_read_next(raw, start + str.len(prefix)).value
}
fn bench_child_command() -> str {
    let configured = env.get("FPA_SELF_CMD")
    if configured != "" {
        return configured
    }
    let current = process.command_name()
    if current != "" && io.is_file(current) == 1 {
        return current
    }
    return "./src/.fz/build/main"
}
fn timed_policy_run_direct(loaded: model.model_loader.LoadedModel, model_dir: str, page_tokens: i32, hot_budget_pct: i32, max_new_tokens: i32, policy_name: str, prompt: model.tokenizer_bridge.TokenizedText) -> str {
    return runtime.decode_loop.run_timed_wire_direct(loaded, model_dir, page_tokens, hot_budget_pct, max_new_tokens, policy_name, prompt)
}
fn budget_prefix(budget_label: str) -> str {
    return str.concat("artifacts/bench_budget_", budget_safe_label(budget_label))
}
fn budget_bundle_from_written_files(budget_label: str) -> str {
    let prefix = budget_prefix(budget_label)
    return bundle_join(fs.read_file(str.concat(prefix, "_report_wire.txt")), fs.read_file(str.concat(prefix, "_report_json.txt")), fs.read_file(str.concat(prefix, "_samples_wire.txt")), fs.read_file(str.concat(prefix, "_failures_wire.txt")))
}
fn run_budget_bundle_from_child(model_dir: str, page_tokens: i32, budget_label: str, hot_budget_pct: i32) -> str {
    let argv = proc.argv_new()
    let env_map = proc.env_new()
    discard proc.env_set(env_map, "FPA_MODE", "bench_budget")
    discard proc.env_set(env_map, "FPA_MODEL_DIR", model_dir)
    discard proc.env_set(env_map, "FPA_PAGE_TOKENS", str.from_i32(page_tokens))
    discard proc.env_set(env_map, "FPA_HOT_BUDGET_PCT", str.from_i32(hot_budget_pct))
    discard proc.env_set(env_map, "FPA_BENCH_BUDGET_LABEL", budget_label)
    if env.get("FPA_BENCH_PROFILE") != "" {
        discard proc.env_set(env_map, "FPA_BENCH_PROFILE", env.get("FPA_BENCH_PROFILE"))
    }
    if env.get("FPA_BENCH_LIMIT") != "" {
        discard proc.env_set(env_map, "FPA_BENCH_LIMIT", env.get("FPA_BENCH_LIMIT"))
    }
    if env.get("FPA_BENCH_OFFSET") != "" {
        discard proc.env_set(env_map, "FPA_BENCH_OFFSET", env.get("FPA_BENCH_OFFSET"))
    }
    if env.get("FPA_BENCH_TIMEOUT_MS") != "" {
        discard proc.env_set(env_map, "FPA_BENCH_TIMEOUT_MS", env.get("FPA_BENCH_TIMEOUT_MS"))
    }
    discard proc.env_set(env_map, "FPA_TRACE_RUNTIME", "1")
    let handle = proc.spawn_cmd(bench_child_command(), argv, env_map, "")
    defer process.close(handle)
    let timeout_ms = bench_budget_timeout_ms(model_dir)
    let wait_started_ms = time.monotonic_ms()
    let mut ready = proc.poll(handle)
    while ready == 0 && (time.monotonic_ms() - wait_started_ms) < timeout_ms {
        discard time.sleep_ms(10)
        ready = proc.poll(handle)
    }
    if ready == 0 {
        discard proc.wait(handle, 1)
    } else {
        discard proc.wait(handle, timeout_ms)
    }
    let stdout = proc.stdout(handle)
    let stderr = proc.stderr(handle)
    let exit_code = proc.exit_code(handle)
    let payload = bench_budget_bundle_payload(stdout)
    let bundle = budget_bundle_from_written_files(budget_label)
    if trace_enabled() == 1 {
        discard term.write(
            str.concat(
                str.concat(
                    str.concat(
                        str.concat(
                            str.concat(
                                "FPA_TRACE_BENCH_BUDGET_CHILD budget=",
                                budget_label
                            ),
                            str.concat(" exit_code=", str.from_i32(exit_code))
                        ),
                        str.concat(" stdout_len=", str.from_i32(str.len(stdout)))
                    ),
                    str.concat(
                        str.concat(" stderr_len=", str.from_i32(str.len(stderr))),
                        str.concat(" bundle_len=", str.from_i32(str.len(bundle)))
                    )
                ),
                str.concat(str.concat(" payload_len=", str.from_i32(str.len(payload))), "\n")
            )
        )
    }
    if exit_code != 0 || bundle == "" {
        discard term.write_err(
            str.concat(
                str.concat(
                    str.concat(
                        str.concat("FPA_BENCH_BUDGET_CHILD_ERROR budget=", budget_label),
                        str.concat(
                            str.concat(" exit_code=", str.from_i32(exit_code)),
                            str.concat(
                                str.concat(" payload_len=", str.from_i32(str.len(payload))),
                                str.concat(" bundle_len=", str.from_i32(str.len(bundle)))
                            )
                        )
                    ),
                    str.concat(
                        str.concat(" stdout_len=", str.from_i32(str.len(stdout))),
                        str.concat(" stdout_head=", json.str(take_chars(stdout, 0, 120)))
                    )
                ),
                str.concat(
                    str.concat(
                        str.concat(" stderr_len=", str.from_i32(str.len(stderr))),
                        str.concat(" stderr_head=", json.str(take_chars(stderr, 0, 120)))
                    ),
                    "\n"
                )
            )
        )
    }
    return bundle
}
fn bundle_join(report_wire: str, report_json: str, sample_rows_wire: str, failure_rows_wire: str) -> str {
    return frame_push(frame_push(frame_push(frame_push("", report_wire), report_json), sample_rows_wire), failure_rows_wire)
}
fn bundle_part_at(bundle: str, position: i32) -> str {
    return frame_value_at(bundle, position)
}
fn aggregate_json(report: PolicyAggregate) -> str {
    return aggregate_json_from_full(report.policy_name, report.sample_count, report.exact_match_count, report.contains_target_count, report.matching_tokens, report.total_tokens, report.avg_effective_bytes_per_token * report.total_tokens, report.avg_block_remaps_per_sample * report.sample_count, report.avg_old_pages_streamed * report.sample_count, report.avg_raw_pages_streamed * report.sample_count, report.avg_ttft_ms * report.sample_count, report.avg_latency_ms * report.sample_count, report.avg_tokens_per_sec * report.sample_count, report.avg_steady_tokens_per_sec * report.sample_count)
}
fn aggregate_json_from(policy_name: str, sample_count: i32, exact_match_count: i32, contains_target_count: i32, matching_tokens: i32, total_tokens: i32, effective_bytes_total: i32, block_remaps_total: i32, old_pages_total: i32, raw_pages_total: i32) -> str {
    return aggregate_json_from_full(policy_name, sample_count, exact_match_count, contains_target_count, matching_tokens, total_tokens, effective_bytes_total, block_remaps_total, old_pages_total, raw_pages_total, 0, 0, 0, 0)
}
fn aggregate_json_from_full(policy_name: str, sample_count: i32, exact_match_count: i32, contains_target_count: i32, matching_tokens: i32, total_tokens: i32, effective_bytes_total: i32, block_remaps_total: i32, old_pages_total: i32, raw_pages_total: i32, ttft_ms_total: i32, latency_ms_total: i32, tokens_per_sec_total: i32, steady_tokens_per_sec_total: i32) -> str {
    let top1 = if total_tokens <= 0 {
        0
    } else {
        (matching_tokens * 100) / total_tokens
    }
    let avg_effective = if total_tokens <= 0 {
        0
    } else {
        effective_bytes_total / total_tokens
    }
    let avg_remaps = if sample_count <= 0 {
        0
    } else {
        block_remaps_total / sample_count
    }
    let avg_old = if sample_count <= 0 {
        0
    } else {
        old_pages_total / sample_count
    }
    let avg_raw = if sample_count <= 0 {
        0
    } else {
        raw_pages_total / sample_count
    }
    let avg_ttft_ms = if sample_count <= 0 {
        0
    } else {
        ttft_ms_total / sample_count
    }
    let avg_latency_ms = if sample_count <= 0 {
        0
    } else {
        latency_ms_total / sample_count
    }
    let avg_tokens_per_sec = if sample_count <= 0 {
        0
    } else {
        tokens_per_sec_total / sample_count
    }
    let avg_steady_tokens_per_sec = if sample_count <= 0 {
        0
    } else {
        steady_tokens_per_sec_total / sample_count
    }
    return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("{\"policy\":", json.str(policy_name)), str.concat(",\"sample_count\":", str.from_i32(sample_count))), str.concat(",\"exact_match_count\":", str.from_i32(exact_match_count))), str.concat(",\"contains_target_count\":", str.from_i32(contains_target_count))), str.concat(",\"matching_tokens\":", str.from_i32(matching_tokens))), str.concat(",\"total_tokens\":", str.from_i32(total_tokens))), str.concat(",\"top1_agreement_pct\":", str.from_i32(top1))), str.concat(",\"avg_effective_bytes_per_token\":", str.from_i32(avg_effective))), str.concat(",\"avg_block_remaps_per_sample\":", str.from_i32(avg_remaps))), str.concat(",\"avg_old_pages_streamed\":", str.from_i32(avg_old))), str.concat(",\"avg_raw_pages_streamed\":", str.from_i32(avg_raw))), str.concat(",\"avg_ttft_ms\":", str.from_i32(avg_ttft_ms))), str.concat(",\"avg_latency_ms\":", str.from_i32(avg_latency_ms))), str.concat(str.concat(str.concat(",\"avg_tokens_per_sec\":", str.from_i32(avg_tokens_per_sec)), str.concat(",\"avg_steady_tokens_per_sec\":", str.from_i32(avg_steady_tokens_per_sec))), "}"))
}
