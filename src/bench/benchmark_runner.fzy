}
fn policy_results_row(report: BenchmarkReport, aggregate: PolicyAggregate, failure_rows_wire: str) -> str {
    return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("| ", report.budget_label), str.concat(" | ", aggregate.policy_name)), str.concat(" | ", str.from_i32(aggregate.sample_count))), str.concat(" | ", str.from_i32(aggregate.top1_agreement_pct))), str.concat(" | ", str.from_i32(aggregate.avg_effective_bytes_per_token))), str.concat(" | ", str.from_i32(aggregate.avg_block_remaps_per_sample))), str.concat(" | ", str.from_i32(aggregate.avg_old_pages_streamed))), str.concat(str.concat(" | ", str.from_i32(failure_count_by_budget_and_policy(failure_rows_wire, report.budget_label, aggregate.policy_name))), " |\n"))
}
fn append_failure_examples_text(out: str, failure_rows_wire: str, limit: i32, seen: i32) -> str {
    let row_count = collection_count(failure_rows_wire) let mut next = out let mut idx = 0 let mut emitted = seen while idx < row_count && emitted < limit {
        let row = sample_row_from_wire(collection_item_at(failure_rows_wire, idx)) next = str.concat(next, str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("- `", row.budget_label), "/"), row.policy_name), str.concat("/", row.sample_id)), "` top1="), str.from_i32(row.top1_agreement_pct)), str.concat("% parity=", str.concat(str.from_i32(row.parity_match), str.concat(" target=", str.concat(json.str(row.target_hint), "\n")))))) idx = idx + 1 emitted = emitted + 1
    }
    return next
}
fn matrix_prefix(model_dir: str) -> str {
    return str.concat("fpa_bench_", str.concat(model.artifacts.model_id_from_dir(model_dir), "_matrix"))
}
fn hardware_label() -> str {
    let configured = env.get("FPA_HARDWARE") if configured != "" {
        return configured
    }
    return "Apple Silicon unified-memory host"
}
fn frame_push(frame: str, value: str) -> str {
    return str.concat(str.concat(frame, str.from_i32(str.len(value))), str.concat("#", value))
}
fn frame_sep(frame: str, start: i32) -> i32 {
    let mut idx = start while idx < str.len(frame) {
        if str.slice(frame, idx, idx + 1) == "#" {
            return idx
        }
        idx = idx + 1
    }
    return - 1
}
fn frame_skip_next(frame: str, start: i32) -> i32 {
    let sep = frame_sep(frame, start)
    if sep < 0 {
        return str.len(frame)
    }
    let size = parse_decimal(str.slice(frame, start, sep))
    let value_start = sep + 1
    return value_start + size
}
fn frame_read_next(frame: str, start: i32) -> FrameRead {
    let sep = frame_sep(frame, start) if sep < 0 {
        return FrameRead {
            value: "", next_idx: str.len(frame)
        }
    }
    let size = parse_decimal(str.slice(frame, start, sep)) let value_start = sep + 1 let value_end = value_start + size return FrameRead {
        value: str.slice(frame, value_start, value_end), next_idx: value_end,
    }
}
fn frame_value_at(frame: str, position: i32) -> str {
    let mut idx = 0 let mut current = 0 while idx < str.len(frame) {
        let sep = frame_sep(frame, idx) if sep < 0 {
            return ""
        }
        let size = parse_decimal(str.slice(frame, idx, sep)) let start = sep + 1 let end = start + size if current == position {
            return str.slice(frame, start, end)
        }
        current = current + 1 idx = end
    }
    return ""
}
fn run(shape: model.EngineShape, model_dir: str, page_tokens: i32, hot_budget_pct: i32) -> BenchmarkReport {
    return run_detailed(shape, model_dir, page_tokens, hot_budget_pct).report
}
fn matrix_artifacts_from_budget(artifacts: BenchmarkArtifacts) -> BenchmarkMatrixArtifacts {
    return BenchmarkMatrixArtifacts {
        budget_count: 1, budget_reports_wire: benchmark_report_wire(artifacts.report), sample_rows_wire: artifacts.sample_rows_wire, failure_rows_wire: artifacts.failure_rows_wire,
    }
}
fn run_json(shape: model.EngineShape, model_dir: str, page_tokens: i32, hot_budget_pct: i32) -> str {
    return benchmark_report_json(run(shape, model_dir, page_tokens, hot_budget_pct))
}
