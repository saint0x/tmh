    return aggregate_wire_from_fields_full(policy_name, sample_count, exact_match_count, contains_target_count, matching_tokens, total_tokens, effective_bytes_total, block_remaps_total, old_pages_total, raw_pages_total, 0, 0, 0, 0)
}
fn aggregate_wire_from_fields_full(policy_name: str, sample_count: i32, exact_match_count: i32, contains_target_count: i32, matching_tokens: i32, total_tokens: i32, effective_bytes_total: i32, block_remaps_total: i32, old_pages_total: i32, raw_pages_total: i32, ttft_ms_total: i32, latency_ms_total: i32, tokens_per_sec_total: i32, steady_tokens_per_sec_total: i32) -> str {
    let top1 = if total_tokens <= 0 {
        0
    } else {
        (matching_tokens * 100) / total_tokens
    }
    let avg_effective = if total_tokens <= 0 {
        0
    } else {
        effective_bytes_total / total_tokens
    }
    let avg_remaps = if sample_count <= 0 {
        0
    } else {
        block_remaps_total / sample_count
    }
    let avg_old = if sample_count <= 0 {
        0
    } else {
        old_pages_total / sample_count
    }
    let avg_raw = if sample_count <= 0 {
        0
    } else {
        raw_pages_total / sample_count
    }
    let avg_ttft_ms = if sample_count <= 0 { 0 } else { ttft_ms_total / sample_count }
    let avg_latency_ms = if sample_count <= 0 { 0 } else { latency_ms_total / sample_count }
    let avg_tokens_per_sec = if sample_count <= 0 { 0 } else { tokens_per_sec_total / sample_count }
    let avg_steady_tokens_per_sec = if sample_count <= 0 { 0 } else { steady_tokens_per_sec_total / sample_count }
    let mut wire = "" wire = frame_push(wire, policy_name) wire = frame_push(wire, str.from_i32(sample_count)) wire = frame_push(wire, str.from_i32(exact_match_count)) wire = frame_push(wire, str.from_i32(contains_target_count)) wire = frame_push(wire, str.from_i32(matching_tokens)) wire = frame_push(wire, str.from_i32(total_tokens)) wire = frame_push(wire, str.from_i32(top1)) wire = frame_push(wire, str.from_i32(avg_effective)) wire = frame_push(wire, str.from_i32(avg_remaps)) wire = frame_push(wire, str.from_i32(avg_old)) wire = frame_push(wire, str.from_i32(avg_raw)) wire = frame_push(wire, str.from_i32(avg_ttft_ms)) wire = frame_push(wire, str.from_i32(avg_latency_ms)) wire = frame_push(wire, str.from_i32(avg_tokens_per_sec)) wire = frame_push(wire, str.from_i32(avg_steady_tokens_per_sec)) return wire
}
fn aggregate_from_wire(raw: str, fallback_policy_name: str) -> PolicyAggregate {
    let policy_name = frame_value_at(raw, 0)
    return PolicyAggregate {
        policy_name: if policy_name == "" {
            fallback_policy_name
        } else {
            policy_name
        }
        , sample_count: parse_decimal(frame_value_at(raw, 1)), exact_match_count: parse_decimal(frame_value_at(raw, 2)), contains_target_count: parse_decimal(frame_value_at(raw, 3)), matching_tokens: parse_decimal(frame_value_at(raw, 4)), total_tokens: parse_decimal(frame_value_at(raw, 5)), top1_agreement_pct: parse_decimal(frame_value_at(raw, 6)), avg_effective_bytes_per_token: parse_decimal(frame_value_at(raw, 7)), avg_block_remaps_per_sample: parse_decimal(frame_value_at(raw, 8)), avg_old_pages_streamed: parse_decimal(frame_value_at(raw, 9)), avg_raw_pages_streamed: parse_decimal(frame_value_at(raw, 10)), avg_ttft_ms: parse_decimal(frame_value_at(raw, 11)), avg_latency_ms: parse_decimal(frame_value_at(raw, 12)), avg_tokens_per_sec: parse_decimal(frame_value_at(raw, 13)), avg_steady_tokens_per_sec: parse_decimal(frame_value_at(raw, 14)),
    }
}
fn benchmark_report_wire(report: BenchmarkReport) -> str {
    return benchmark_report_wire_from_fields(report.budget_label, report.hot_budget_pct, report.suite_size, report.full_kv, report.paged_full_kv, report.recent_only, report.quantized_old_kv, report.fidelity_paged_kv)
}
fn benchmark_report_wire_from_fields(budget_label: str, hot_budget_pct: i32, suite_size: i32, full_kv: PolicyAggregate, paged_full_kv: PolicyAggregate, recent_only: PolicyAggregate, quantized_old_kv: PolicyAggregate, fidelity_paged_kv: PolicyAggregate) -> str {
    let mut wire = "" wire = frame_push(wire, budget_label) wire = frame_push(wire, str.from_i32(hot_budget_pct)) wire = frame_push(wire, str.from_i32(suite_size)) wire = frame_push(wire, aggregate_wire(full_kv)) wire = frame_push(wire, aggregate_wire(paged_full_kv)) wire = frame_push(wire, aggregate_wire(recent_only)) wire = frame_push(wire, aggregate_wire(quantized_old_kv)) wire = frame_push(wire, aggregate_wire(fidelity_paged_kv)) return wire
}
fn benchmark_report_wire_from_totals(budget_label: str, hot_budget_pct: i32, suite_size: i32, full_sample_count: i32, full_exact_match_count: i32, full_contains_target_count: i32, full_matching_tokens: i32, full_total_tokens: i32, full_effective_bytes_total: i32, full_block_remaps_total: i32, full_old_pages_total: i32, full_raw_pages_total: i32, full_ttft_ms_total: i32, full_latency_ms_total: i32, full_tokens_per_sec_total: i32, full_steady_tokens_per_sec_total: i32, paged_sample_count: i32, paged_exact_match_count: i32, paged_contains_target_count: i32, paged_matching_tokens: i32, paged_total_tokens: i32, paged_effective_bytes_total: i32, paged_block_remaps_total: i32, paged_old_pages_total: i32, paged_raw_pages_total: i32, paged_ttft_ms_total: i32, paged_latency_ms_total: i32, paged_tokens_per_sec_total: i32, paged_steady_tokens_per_sec_total: i32, recent_sample_count: i32, recent_exact_match_count: i32, recent_contains_target_count: i32, recent_matching_tokens: i32, recent_total_tokens: i32, recent_effective_bytes_total: i32, recent_block_remaps_total: i32, recent_old_pages_total: i32, recent_raw_pages_total: i32, recent_ttft_ms_total: i32, recent_latency_ms_total: i32, recent_tokens_per_sec_total: i32, recent_steady_tokens_per_sec_total: i32, quant_sample_count: i32, quant_exact_match_count: i32, quant_contains_target_count: i32, quant_matching_tokens: i32, quant_total_tokens: i32, quant_effective_bytes_total: i32, quant_block_remaps_total: i32, quant_old_pages_total: i32, quant_raw_pages_total: i32, quant_ttft_ms_total: i32, quant_latency_ms_total: i32, quant_tokens_per_sec_total: i32, quant_steady_tokens_per_sec_total: i32, fidelity_sample_count: i32, fidelity_exact_match_count: i32, fidelity_contains_target_count: i32, fidelity_matching_tokens: i32, fidelity_total_tokens: i32, fidelity_effective_bytes_total: i32, fidelity_block_remaps_total: i32, fidelity_old_pages_total: i32, fidelity_raw_pages_total: i32, fidelity_ttft_ms_total: i32, fidelity_latency_ms_total: i32, fidelity_tokens_per_sec_total: i32, fidelity_steady_tokens_per_sec_total: i32) -> str {
    let mut wire = "" wire = frame_push(wire, budget_label) wire = frame_push(wire, str.from_i32(hot_budget_pct)) wire = frame_push(wire, str.from_i32(suite_size)) wire = frame_push(wire, aggregate_wire_from_fields_full("full_kv", full_sample_count, full_exact_match_count, full_contains_target_count, full_matching_tokens, full_total_tokens, full_effective_bytes_total, full_block_remaps_total, full_old_pages_total, full_raw_pages_total, full_ttft_ms_total, full_latency_ms_total, full_tokens_per_sec_total, full_steady_tokens_per_sec_total)) wire = frame_push(wire, aggregate_wire_from_fields_full("paged_full_kv", paged_sample_count, paged_exact_match_count, paged_contains_target_count, paged_matching_tokens, paged_total_tokens, paged_effective_bytes_total, paged_block_remaps_total, paged_old_pages_total, paged_raw_pages_total, paged_ttft_ms_total, paged_latency_ms_total, paged_tokens_per_sec_total, paged_steady_tokens_per_sec_total)) wire = frame_push(wire, aggregate_wire_from_fields_full("recent_only", recent_sample_count, recent_exact_match_count, recent_contains_target_count, recent_matching_tokens, recent_total_tokens, recent_effective_bytes_total, recent_block_remaps_total, recent_old_pages_total, recent_raw_pages_total, recent_ttft_ms_total, recent_latency_ms_total, recent_tokens_per_sec_total, recent_steady_tokens_per_sec_total)) wire = frame_push(wire, aggregate_wire_from_fields_full("quantized_old_kv", quant_sample_count, quant_exact_match_count, quant_contains_target_count, quant_matching_tokens, quant_total_tokens, quant_effective_bytes_total, quant_block_remaps_total, quant_old_pages_total, quant_raw_pages_total, quant_ttft_ms_total, quant_latency_ms_total, quant_tokens_per_sec_total, quant_steady_tokens_per_sec_total)) wire = frame_push(wire, aggregate_wire_from_fields_full("fidelity_paged_kv", fidelity_sample_count, fidelity_exact_match_count, fidelity_contains_target_count, fidelity_matching_tokens, fidelity_total_tokens, fidelity_effective_bytes_total, fidelity_block_remaps_total, fidelity_old_pages_total, fidelity_raw_pages_total, fidelity_ttft_ms_total, fidelity_latency_ms_total, fidelity_tokens_per_sec_total, fidelity_steady_tokens_per_sec_total)) return wire
}
fn benchmark_report_json_from_fields(budget_label: str, hot_budget_pct: i32, suite_size: i32, full_kv: PolicyAggregate, paged_full_kv: PolicyAggregate, recent_only: PolicyAggregate, quantized_old_kv: PolicyAggregate, fidelity_paged_kv: PolicyAggregate) -> str {
    let payload = map.new() discard map.set(payload, "budget_label", json.str(budget_label)) discard map.set(payload, "hot_budget_pct", model.json_emit.i32(hot_budget_pct)) discard map.set(payload, "suite_size", model.json_emit.i32(suite_size)) discard map.set(payload, "full_kv", model.json_emit.raw(aggregate_json(full_kv))) discard map.set(payload, "paged_full_kv", model.json_emit.raw(aggregate_json(paged_full_kv))) discard map.set(payload, "recent_only", model.json_emit.raw(aggregate_json(recent_only))) discard map.set(payload, "quantized_old_kv", model.json_emit.raw(aggregate_json(quantized_old_kv))) discard map.set(payload, "fidelity_paged_kv", model.json_emit.raw(aggregate_json(fidelity_paged_kv))) return json.object(payload)
}
