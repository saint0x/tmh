    budget_reports_wire = append_wire(budget_reports_wire, bundle_part_at(budget25, 0))
    budget_reports_wire = append_wire(budget_reports_wire, bundle_part_at(budget12_5, 0))
    budget_reports_wire = append_wire(budget_reports_wire, bundle_part_at(budget6_25, 0))
    budget_reports_wire = append_wire(budget_reports_wire, bundle_part_at(budget0, 0))
    let mut sample_rows_wire = ""
    sample_rows_wire = append_rows_wire(sample_rows_wire, bundle_part_at(budget50, 2))
    sample_rows_wire = append_rows_wire(sample_rows_wire, bundle_part_at(budget25, 2))
    sample_rows_wire = append_rows_wire(sample_rows_wire, bundle_part_at(budget12_5, 2))
    sample_rows_wire = append_rows_wire(sample_rows_wire, bundle_part_at(budget6_25, 2))
    sample_rows_wire = append_rows_wire(sample_rows_wire, bundle_part_at(budget0, 2))
    let mut failure_rows_wire = ""
    failure_rows_wire = append_rows_wire(failure_rows_wire, bundle_part_at(budget50, 3))
    failure_rows_wire = append_rows_wire(failure_rows_wire, bundle_part_at(budget25, 3))
    failure_rows_wire = append_rows_wire(failure_rows_wire, bundle_part_at(budget12_5, 3))
    failure_rows_wire = append_rows_wire(failure_rows_wire, bundle_part_at(budget6_25, 3))
    failure_rows_wire = append_rows_wire(failure_rows_wire, bundle_part_at(budget0, 3))
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE_BENCH report_count=", str.from_i32(collection_count(budget_reports_wire))), "\n"))
    }
    return frame_push(frame_push(frame_push("", budget_reports_wire), sample_rows_wire), failure_rows_wire)
}
fn matrix_budget_reports_wire(bundle: str) -> str {
    return frame_value_at(bundle, 0)
}
fn matrix_sample_rows_wire(bundle: str) -> str {
    return frame_value_at(bundle, 1)
}
fn matrix_failure_rows_wire(bundle: str) -> str {
    return frame_value_at(bundle, 2)
}
fn budget_safe_label(budget_label: str) -> str {
    if budget_label == "50" {
        return "50"
    }
    if budget_label == "25" {
        return "25"
    }
    if budget_label == "12.5" {
        return "12_5"
    }
    if budget_label == "6.25" {
        return "6_25"
    }
    if budget_label == "0" {
        return "0"
    }
    return "unknown"
}
fn budget_label_from_pct(hot_budget_pct: i32) -> str {
    if hot_budget_pct >= 50 {
        return "50"
    }
    if hot_budget_pct >= 25 {
        return "25"
    }
    if hot_budget_pct >= 13 {
        return "12.5"
    }
    if hot_budget_pct >= 6 {
        return "6.25"
    }
    return "0"
}
fn aggregate_wire_for_policy(sample_rows_wire: str, policy_name: str) -> str {
    let total_rows = collection_count(sample_rows_wire)
    let mut sample_count = 0
    let mut exact_match_count = 0
    let mut contains_target_count = 0
    let mut matching_tokens = 0
    let mut total_tokens = 0
    let mut effective_bytes_total = 0
    let mut block_remaps_total = 0
    let mut old_pages_total = 0
    let mut raw_pages_total = 0
    let mut ttft_ms_total = 0
    let mut latency_ms_total = 0
    let mut tokens_per_sec_total = 0
    let mut steady_tokens_per_sec_total = 0
    let mut idx = 0
    while idx < total_rows {
        let row_wire = collection_item_at(sample_rows_wire, idx)
        if frame_value_at(row_wire, 4) == policy_name {
            sample_count = sample_count + 1
            exact_match_count = exact_match_count + parse_decimal(frame_value_at(row_wire, 13))
            contains_target_count = contains_target_count + parse_decimal(frame_value_at(row_wire, 14))
            matching_tokens = matching_tokens + parse_decimal(frame_value_at(row_wire, 15))
            total_tokens = total_tokens + parse_decimal(frame_value_at(row_wire, 16))
            effective_bytes_total = effective_bytes_total + parse_decimal(frame_value_at(row_wire, 19))
            block_remaps_total = block_remaps_total + parse_decimal(frame_value_at(row_wire, 20))
            old_pages_total = old_pages_total + parse_decimal(frame_value_at(row_wire, 22))
            raw_pages_total = raw_pages_total + parse_decimal(frame_value_at(row_wire, 23))
            ttft_ms_total = ttft_ms_total + parse_decimal(frame_value_at(row_wire, 25))
            latency_ms_total = latency_ms_total + parse_decimal(frame_value_at(row_wire, 26))
            tokens_per_sec_total = tokens_per_sec_total + parse_decimal(frame_value_at(row_wire, 27))
            steady_tokens_per_sec_total = steady_tokens_per_sec_total + parse_decimal(frame_value_at(row_wire, 28))
        }
        idx = idx + 1
    }
    return aggregate_wire_from_fields_full(policy_name, sample_count, exact_match_count, contains_target_count, matching_tokens, total_tokens, effective_bytes_total, block_remaps_total, old_pages_total, raw_pages_total, ttft_ms_total, latency_ms_total, tokens_per_sec_total, steady_tokens_per_sec_total)
}
fn benchmark_report_wire_from_rows_wire(budget_label: str, hot_budget_pct: i32, suite_size: i32, sample_rows_wire: str) -> str {
    let mut wire = ""
    wire = frame_push(wire, budget_label)
    wire = frame_push(wire, str.from_i32(hot_budget_pct))
    wire = frame_push(wire, str.from_i32(suite_size))
    wire = frame_push(wire, aggregate_wire_for_policy(sample_rows_wire, "full_kv"))
    wire = frame_push(wire, aggregate_wire_for_policy(sample_rows_wire, "paged_full_kv"))
    wire = frame_push(wire, aggregate_wire_for_policy(sample_rows_wire, "recent_only"))
    wire = frame_push(wire, aggregate_wire_for_policy(sample_rows_wire, "quantized_old_kv"))
    wire = frame_push(wire, aggregate_wire_for_policy(sample_rows_wire, "fidelity_paged_kv"))
    return wire
}
fn aggregate_json_from_wire_direct(raw: str, fallback_policy_name: str) -> str {
    let policy_name = frame_value_at(raw, 0) let sample_count = parse_decimal(frame_value_at(raw, 1)) let exact_match_count = parse_decimal(frame_value_at(raw, 2)) let contains_target_count = parse_decimal(frame_value_at(raw, 3)) let matching_tokens = parse_decimal(frame_value_at(raw, 4)) let total_tokens = parse_decimal(frame_value_at(raw, 5)) let effective_total = parse_decimal(frame_value_at(raw, 7)) * total_tokens let remaps_total = parse_decimal(frame_value_at(raw, 8)) * sample_count let old_pages_total = parse_decimal(frame_value_at(raw, 9)) * sample_count let raw_pages_total = parse_decimal(frame_value_at(raw, 10)) * sample_count let ttft_ms_total = parse_decimal(frame_value_at(raw, 11)) * sample_count let latency_ms_total = parse_decimal(frame_value_at(raw, 12)) * sample_count let tokens_per_sec_total = parse_decimal(frame_value_at(raw, 13)) * sample_count let steady_tokens_per_sec_total = parse_decimal(frame_value_at(raw, 14)) * sample_count return aggregate_json_from_full(if policy_name == "" { fallback_policy_name } else { policy_name }, sample_count, exact_match_count, contains_target_count, matching_tokens, total_tokens, effective_total, remaps_total, old_pages_total, raw_pages_total, ttft_ms_total, latency_ms_total, tokens_per_sec_total, steady_tokens_per_sec_total)
}
fn benchmark_report_json_from_wire_direct(raw: str) -> str {
    return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("{\"budget_label\":", json.str(frame_value_at(raw, 0))), str.concat(",\"hot_budget_pct\":", str.from_i32(parse_decimal(frame_value_at(raw, 1))))), str.concat(",\"suite_size\":", str.from_i32(parse_decimal(frame_value_at(raw, 2))))), str.concat(",\"full_kv\":", aggregate_json_from_wire_direct(frame_value_at(raw, 3), "full_kv"))), str.concat(",\"paged_full_kv\":", aggregate_json_from_wire_direct(frame_value_at(raw, 4), "paged_full_kv"))), str.concat(",\"recent_only\":", aggregate_json_from_wire_direct(frame_value_at(raw, 5), "recent_only"))), str.concat(",\"quantized_old_kv\":", aggregate_json_from_wire_direct(frame_value_at(raw, 6), "quantized_old_kv"))), str.concat(str.concat(",\"fidelity_paged_kv\":", aggregate_json_from_wire_direct(frame_value_at(raw, 7), "fidelity_paged_kv")), "}"))
}
fn sanitize_csv(text: str) -> str {
    let mut out = ""
    let mut idx = 0
    while idx < str.len(text) {
        let ch = str.slice(text, idx, idx + 1)
        if ch == "," || ch == "\n" || ch == "\r" {
            out = str.concat(out, " ")
        } else if ch == "\"" {
            out = str.concat(out, "'")
        } else {
            out = str.concat(out, ch)
        }
        idx = idx + 1
    }
    return out
}
fn append_text_block(out: str, block: str) -> str {
    if block == "" {
        return out
    }
    if out == "" {
        return block
    }
    return str.concat(out, block)
}
fn sample_csv_header() -> str {
    return "budget_label,hot_budget_pct,sample_id,category,policy_name,prompt_token_count,generated_tokens,exact_match,contains_target,matching_tokens,total_tokens,top1_agreement_pct,edit_distance,effective_bytes_total,block_remap_count_total,copy_on_write_count_total,old_pages_streamed_total,raw_pages_streamed_total,parity_match,ttft_ms,latency_ms,tokens_per_sec,steady_tokens_per_sec,target_hint,generated_text"
}
