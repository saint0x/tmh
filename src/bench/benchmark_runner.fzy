fn benchmark_report_from_wire(raw: str) -> BenchmarkReport {
    return BenchmarkReport {
        budget_label: frame_value_at(raw, 0), hot_budget_pct: parse_decimal(frame_value_at(raw, 1)), suite_size: parse_decimal(frame_value_at(raw, 2)), full_kv: aggregate_from_wire(frame_value_at(raw, 3), "full_kv"), paged_full_kv: aggregate_from_wire(frame_value_at(raw, 4), "paged_full_kv"), recent_only: aggregate_from_wire(frame_value_at(raw, 5), "recent_only"), quantized_old_kv: aggregate_from_wire(frame_value_at(raw, 6), "quantized_old_kv"), fidelity_paged_kv: aggregate_from_wire(frame_value_at(raw, 7), "fidelity_paged_kv"),
    }
}
fn zero_aggregate(policy_name: str) -> PolicyAggregate {
    return PolicyAggregate {
        policy_name: policy_name, sample_count: 0, exact_match_count: 0, contains_target_count: 0, matching_tokens: 0, total_tokens: 0, top1_agreement_pct: 0, avg_effective_bytes_per_token: 0, avg_block_remaps_per_sample: 0, avg_old_pages_streamed: 0, avg_raw_pages_streamed: 0, avg_ttft_ms: 0, avg_latency_ms: 0, avg_tokens_per_sec: 0, avg_steady_tokens_per_sec: 0,
    }
}
fn aggregate_from_totals(policy_name: str, sample_count: i32, exact_match_count: i32, contains_target_count: i32, matching_tokens: i32, total_tokens: i32, effective_bytes_total: i32, block_remaps_total: i32, old_pages_total: i32, raw_pages_total: i32, ttft_ms_total: i32, latency_ms_total: i32, tokens_per_sec_total: i32, steady_tokens_per_sec_total: i32) -> PolicyAggregate {
    return PolicyAggregate {
        policy_name: policy_name, sample_count: sample_count, exact_match_count: exact_match_count, contains_target_count: contains_target_count, matching_tokens: matching_tokens, total_tokens: total_tokens, top1_agreement_pct: if total_tokens <= 0 {
            0
        } else {
            (matching_tokens * 100) / total_tokens
        }
        , avg_effective_bytes_per_token: if total_tokens <= 0 {
            0
        } else {
            effective_bytes_total / total_tokens
        }
        , avg_block_remaps_per_sample: if sample_count <= 0 {
            0
        } else {
            block_remaps_total / sample_count
        }
        , avg_old_pages_streamed: if sample_count <= 0 {
            0
        } else {
            old_pages_total / sample_count
        }
        , avg_raw_pages_streamed: if sample_count <= 0 {
            0
        } else {
            raw_pages_total / sample_count
        }
        , avg_ttft_ms: if sample_count <= 0 { 0 } else { ttft_ms_total / sample_count }
        , avg_latency_ms: if sample_count <= 0 { 0 } else { latency_ms_total / sample_count }
        , avg_tokens_per_sec: if sample_count <= 0 { 0 } else { tokens_per_sec_total / sample_count }
        , avg_steady_tokens_per_sec: if sample_count <= 0 { 0 } else { steady_tokens_per_sec_total / sample_count }
        ,
    }
}
fn aggregate_rows_for_policy(sample_rows_wire: str, policy_name: str) -> PolicyAggregate {
    let total_rows = collection_count(sample_rows_wire)
    let mut sample_count = 0
    let mut exact_match_count = 0
    let mut contains_target_count = 0
    let mut matching_tokens = 0
    let mut total_tokens = 0
    let mut effective_bytes_total = 0
    let mut block_remaps_total = 0
    let mut old_pages_total = 0
    let mut raw_pages_total = 0
    let mut ttft_ms_total = 0
    let mut latency_ms_total = 0
    let mut tokens_per_sec_total = 0
    let mut steady_tokens_per_sec_total = 0
    let mut idx = 0
    while idx < total_rows {
        let row_wire = collection_item_at(sample_rows_wire, idx)
        if frame_value_at(row_wire, 4) == policy_name {
            sample_count = sample_count + 1
            exact_match_count = exact_match_count + parse_decimal(frame_value_at(row_wire, 13))
            contains_target_count = contains_target_count + parse_decimal(frame_value_at(row_wire, 14))
            matching_tokens = matching_tokens + parse_decimal(frame_value_at(row_wire, 15))
            total_tokens = total_tokens + parse_decimal(frame_value_at(row_wire, 16))
            effective_bytes_total = effective_bytes_total + parse_decimal(frame_value_at(row_wire, 19))
            block_remaps_total = block_remaps_total + parse_decimal(frame_value_at(row_wire, 20))
            old_pages_total = old_pages_total + parse_decimal(frame_value_at(row_wire, 22))
            raw_pages_total = raw_pages_total + parse_decimal(frame_value_at(row_wire, 23))
            ttft_ms_total = ttft_ms_total + parse_decimal(frame_value_at(row_wire, 25))
            latency_ms_total = latency_ms_total + parse_decimal(frame_value_at(row_wire, 26))
            tokens_per_sec_total = tokens_per_sec_total + parse_decimal(frame_value_at(row_wire, 27))
            steady_tokens_per_sec_total = steady_tokens_per_sec_total + parse_decimal(frame_value_at(row_wire, 28))
        }
        idx = idx + 1
    }
    return aggregate_from_totals(policy_name, sample_count, exact_match_count, contains_target_count, matching_tokens, total_tokens, effective_bytes_total, block_remaps_total, old_pages_total, raw_pages_total, ttft_ms_total, latency_ms_total, tokens_per_sec_total, steady_tokens_per_sec_total)
}
fn benchmark_report_from_rows(budget_label: str, hot_budget_pct: i32, suite_size: i32, sample_rows_wire: str) -> BenchmarkReport {
    return BenchmarkReport {
        budget_label: budget_label, hot_budget_pct: hot_budget_pct, suite_size: suite_size, full_kv: aggregate_rows_for_policy(sample_rows_wire, "full_kv"), paged_full_kv: aggregate_rows_for_policy(sample_rows_wire, "paged_full_kv"), recent_only: aggregate_rows_for_policy(sample_rows_wire, "recent_only"), quantized_old_kv: aggregate_rows_for_policy(sample_rows_wire, "quantized_old_kv"), fidelity_paged_kv: aggregate_rows_for_policy(sample_rows_wire, "fidelity_paged_kv"),
    }
}
fn append_wire(wire: str, entry: str) -> str {
    if entry == "" {
        return wire
    }
    return frame_push(wire, entry)
}
fn collection_count(wire: str) -> i32 {
    if wire == "" {
        return 0
    }
    let mut total = 0
    let mut idx = 0
    while idx < str.len(wire) {
        let entry = frame_skip_next(wire, idx)
        total = total + 1
        idx = entry
    }
    return total
}
fn collection_item_at(wire: str, position: i32) -> str {
    return frame_value_at(wire, position)
}
fn append_rows_wire(wire: str, rows_wire: str) -> str {
    let row_count = collection_count(rows_wire) let mut out = wire
    let mut idx = 0
    while idx < row_count {
        out = append_wire(out, collection_item_at(rows_wire, idx))
        idx = idx + 1
    }
    return out
}
fn sample_row_wire_from_result_wires(budget_label: str, hot_budget_pct: i32, sample_wire: str, policy_name: str, result_wire: str, baseline_wire: str, comparison_wire: str) -> str {
    let mut wire = "" wire = frame_push(wire, budget_label) wire = frame_push(wire, str.from_i32(hot_budget_pct)) wire = frame_push(wire, bench.stress_suite.sample_id_from_wire(sample_wire)) wire = frame_push(wire, bench.stress_suite.category_from_wire(sample_wire)) wire = frame_push(wire, policy_name) wire = frame_push(wire, bench.stress_suite.prompt_from_wire(sample_wire)) wire = frame_push(wire, bench.stress_suite.target_hint_from_wire(sample_wire)) wire = frame_push(wire, str.from_i32(runtime.decode_loop.prompt_token_count(result_wire))) wire = frame_push(wire, str.from_i32(runtime.decode_loop.generated_tokens(result_wire))) wire = frame_push(wire, runtime.decode_loop.generated_text(result_wire)) wire = frame_push(wire, runtime.decode_loop.generated_token_ids_wire(result_wire)) wire = frame_push(wire, runtime.decode_loop.generated_text(baseline_wire)) wire = frame_push(wire, runtime.decode_loop.generated_token_ids_wire(baseline_wire)) wire = frame_push(wire, str.from_i32(bench.metrics.exact_match(comparison_wire))) wire = frame_push(wire, str.from_i32(bench.metrics.contains_target(comparison_wire))) wire = frame_push(wire, str.from_i32(bench.metrics.matching_tokens(comparison_wire))) wire = frame_push(wire, str.from_i32(bench.metrics.total_tokens(comparison_wire))) wire = frame_push(wire, str.from_i32(bench.metrics.top1_agreement_pct(comparison_wire))) wire = frame_push(wire, str.from_i32(bench.metrics.edit_distance(comparison_wire))) wire = frame_push(wire, str.from_i32(runtime.decode_loop.effective_bytes_total(result_wire))) wire = frame_push(wire, str.from_i32(runtime.decode_loop.block_remap_count_total(result_wire))) wire = frame_push(wire, str.from_i32(runtime.decode_loop.copy_on_write_count_total(result_wire))) wire = frame_push(wire, str.from_i32(runtime.decode_loop.old_pages_streamed_total(result_wire))) wire = frame_push(wire, str.from_i32(runtime.decode_loop.raw_pages_streamed_total(result_wire))) wire = frame_push(wire, str.from_i32(runtime.decode_loop.parity_match(result_wire))) wire = frame_push(wire, "0") wire = frame_push(wire, "0") wire = frame_push(wire, "0") wire = frame_push(wire, "0") return wire
}
fn should_record_failure(row: SampleRow) -> i32 {
    if row.policy_name == "full_kv" {
        if row.parity_match == 0 {
            return 1
        }
        return 0
    }
    if row.exact_match == 0 {
        return 1
    }
    if row.contains_target == 0 {
        return 1
    }
    if row.parity_match == 0 {
        return 1
    }
    return 0
}
fn should_record_failure_from_fields(policy_name: str, exact_match: i32, contains_target: i32, parity_match: i32) -> i32 {
    if policy_name == "full_kv" {
        if parity_match == 0 {
            return 1
        }
        return 0
    }
    if exact_match == 0 {
        return 1
    }
    if contains_target == 0 {
        return 1
    }
    if parity_match == 0 {
        return 1
    }
    return 0
}
fn append_failure_wire(failure_rows_wire: str, row_wire: str, pick_failure: i32) -> str {
    if pick_failure == 1 {
        return append_wire(failure_rows_wire, row_wire)
    }
    return failure_rows_wire
}
fn sample_row_wire_from_timed_result(budget_label: str, hot_budget_pct: i32, sample_wire: str, policy_name: str, timed_wire: str, baseline_wire: str, comparison_wire: str) -> str {
    let result_wire = runtime.decode_loop.timed_decode_result_wire(timed_wire)
    let sample_id = bench.stress_suite.sample_id_from_wire(sample_wire)
    let category = bench.stress_suite.category_from_wire(sample_wire)
    let prompt_text = bench.stress_suite.prompt_from_wire(sample_wire)
    let target_hint = bench.stress_suite.target_hint_from_wire(sample_wire)
    let prompt_token_count = runtime.decode_loop.prompt_token_count(result_wire)
    let generated_tokens = runtime.decode_loop.generated_tokens(result_wire)
    let generated_text = runtime.decode_loop.generated_text(result_wire)
    let generated_token_ids_wire = runtime.decode_loop.generated_token_ids_wire(result_wire)
    let baseline_generated_text = runtime.decode_loop.generated_text(baseline_wire)
    let baseline_generated_token_ids_wire = runtime.decode_loop.generated_token_ids_wire(baseline_wire)
    let exact_match = bench.metrics.exact_match(comparison_wire)
    let contains_target = bench.metrics.contains_target(comparison_wire)
    let matching_tokens = bench.metrics.matching_tokens(comparison_wire)
    let total_tokens = bench.metrics.total_tokens(comparison_wire)
    let top1_agreement_pct = bench.metrics.top1_agreement_pct(comparison_wire)
    let edit_distance = bench.metrics.edit_distance(comparison_wire)
    let effective_bytes_total = runtime.decode_loop.effective_bytes_total(result_wire)
    let block_remap_count_total = runtime.decode_loop.block_remap_count_total(result_wire)
    let copy_on_write_count_total = runtime.decode_loop.copy_on_write_count_total(result_wire)
    let old_pages_streamed_total = runtime.decode_loop.old_pages_streamed_total(result_wire)
    let raw_pages_streamed_total = runtime.decode_loop.raw_pages_streamed_total(result_wire)
    let parity_match = runtime.decode_loop.parity_match(result_wire)
    let ttft_ms = runtime.decode_loop.timed_decode_ttft_ms(timed_wire)
    let latency_ms = runtime.decode_loop.timed_decode_latency_ms(timed_wire)
    let tokens_per_sec = runtime.decode_loop.timed_decode_tokens_per_sec(timed_wire)
    let steady_tokens_per_sec = runtime.decode_loop.timed_decode_steady_tokens_per_sec(timed_wire)
    let mut wire = ""
    wire = frame_push(wire, budget_label)
    wire = frame_push(wire, str.from_i32(hot_budget_pct))
    wire = frame_push(wire, sample_id)
    wire = frame_push(wire, category)
    wire = frame_push(wire, policy_name)
    wire = frame_push(wire, prompt_text)
    wire = frame_push(wire, target_hint)
    wire = frame_push(wire, str.from_i32(prompt_token_count))
    wire = frame_push(wire, str.from_i32(generated_tokens))
    wire = frame_push(wire, generated_text)
    wire = frame_push(wire, generated_token_ids_wire)
    wire = frame_push(wire, baseline_generated_text)
    wire = frame_push(wire, baseline_generated_token_ids_wire)
    wire = frame_push(wire, str.from_i32(exact_match))
    wire = frame_push(wire, str.from_i32(contains_target))
    wire = frame_push(wire, str.from_i32(matching_tokens))
    wire = frame_push(wire, str.from_i32(total_tokens))
    wire = frame_push(wire, str.from_i32(top1_agreement_pct))
    wire = frame_push(wire, str.from_i32(edit_distance))
    wire = frame_push(wire, str.from_i32(effective_bytes_total))
    wire = frame_push(wire, str.from_i32(block_remap_count_total))
    wire = frame_push(wire, str.from_i32(copy_on_write_count_total))
    wire = frame_push(wire, str.from_i32(old_pages_streamed_total))
    wire = frame_push(wire, str.from_i32(raw_pages_streamed_total))
    wire = frame_push(wire, str.from_i32(parity_match))
    wire = frame_push(wire, str.from_i32(ttft_ms))
    wire = frame_push(wire, str.from_i32(latency_ms))
    wire = frame_push(wire, str.from_i32(tokens_per_sec))
    wire = frame_push(wire, str.from_i32(steady_tokens_per_sec))
    return wire
}
fn run_budget_detailed(shape: model.EngineShape, model_dir: str, page_tokens: i32, budget_label: str, hot_budget_pct: i32) -> BenchmarkArtifacts {
    discard fs.mkdir("artifacts")
    let loaded = model.model_loader.load(model_dir, page_tokens)
    let suite_wire = bench.stress_suite.selected_suite_wire(model_dir)
    let suite_total = bench.stress_suite.count(suite_wire)
    let suite_offset = bench_offset(suite_total)
    let suite_size = bench_limit(suite_total - suite_offset)
    let mut sample_rows_wire = ""
    let mut failure_rows_wire = ""
    let mut idx = 0
    while idx < suite_size {
        let sample_wire = bench.stress_suite.item_at(suite_wire, suite_offset + idx)
        let prompt_text = bench.stress_suite.prompt_from_wire(sample_wire)
        let target_hint = bench.stress_suite.target_hint_from_wire(sample_wire)
        let max_new_tokens = bench.stress_suite.max_new_tokens_from_wire(sample_wire)
        let mut sample_batch_wire = ""
        let mut failure_batch_wire = ""
        let prompt = model.tokenizer_bridge.encode(prompt_text, loaded.vocab_size)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat(str.concat(str.concat("FPA_TRACE_BENCH_SAMPLE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), str.concat(" max_new_tokens=", str.from_i32(max_new_tokens))), str.concat(" prompt_chars=", str.from_i32(str.len(prompt_text)))), "\n"))
        }
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_POLICY_BEGIN sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " full_kv\n"))
        }
        let full_timed_wire = timed_policy_run_direct(loaded, model_dir, page_tokens, hot_budget_pct, max_new_tokens, "full_kv", prompt)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_POLICY_BEGIN sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " paged_full_kv\n"))
        }
        let paged_timed_wire = timed_policy_run_direct(loaded, model_dir, page_tokens, hot_budget_pct, max_new_tokens, "paged_full_kv", prompt)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_POLICY_BEGIN sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " recent_only\n"))
        }
        let recent_timed_wire = timed_policy_run_direct(loaded, model_dir, page_tokens, hot_budget_pct, max_new_tokens, "recent_only", prompt)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_POLICY_BEGIN sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " quantized_old_kv\n"))
        }
        let quant_timed_wire = timed_policy_run_direct(loaded, model_dir, page_tokens, hot_budget_pct, max_new_tokens, "quantized_old_kv", prompt)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_POLICY_BEGIN sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " fidelity_paged_kv\n"))
        }
        let fidelity_timed_wire = timed_policy_run_direct(loaded, model_dir, page_tokens, hot_budget_pct, max_new_tokens, "fidelity_paged_kv", prompt)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_POLICY_DONE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), "\n"))
        }
        let full_result_wire = runtime.decode_loop.timed_decode_result_wire(full_timed_wire)
        let paged_result_wire = runtime.decode_loop.timed_decode_result_wire(paged_timed_wire)
        let recent_result_wire = runtime.decode_loop.timed_decode_result_wire(recent_timed_wire)
        let quant_result_wire = runtime.decode_loop.timed_decode_result_wire(quant_timed_wire)
        let fidelity_result_wire = runtime.decode_loop.timed_decode_result_wire(fidelity_timed_wire)
        let baseline_generated_token_ids_wire = runtime.decode_loop.generated_token_ids_wire(full_result_wire)
        let baseline_generated_text = runtime.decode_loop.generated_text(full_result_wire)
        let full_cmp_wire = bench.metrics.compare_wire(baseline_generated_token_ids_wire, baseline_generated_token_ids_wire, baseline_generated_text, baseline_generated_text, target_hint)
        let paged_cmp_wire = bench.metrics.compare_wire(baseline_generated_token_ids_wire, runtime.decode_loop.generated_token_ids_wire(paged_result_wire), baseline_generated_text, runtime.decode_loop.generated_text(paged_result_wire), target_hint)
        let recent_cmp_wire = bench.metrics.compare_wire(baseline_generated_token_ids_wire, runtime.decode_loop.generated_token_ids_wire(recent_result_wire), baseline_generated_text, runtime.decode_loop.generated_text(recent_result_wire), target_hint)
        let quant_cmp_wire = bench.metrics.compare_wire(baseline_generated_token_ids_wire, runtime.decode_loop.generated_token_ids_wire(quant_result_wire), baseline_generated_text, runtime.decode_loop.generated_text(quant_result_wire), target_hint)
        let fidelity_cmp_wire = bench.metrics.compare_wire(baseline_generated_token_ids_wire, runtime.decode_loop.generated_token_ids_wire(fidelity_result_wire), baseline_generated_text, runtime.decode_loop.generated_text(fidelity_result_wire), target_hint)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_COMPARE_DONE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), "\n"))
        }
        let full_row_wire = sample_row_wire_from_timed_result(budget_label, hot_budget_pct, sample_wire, "full_kv", full_timed_wire, full_result_wire, full_cmp_wire)
        sample_batch_wire = append_wire(sample_batch_wire, full_row_wire)
        failure_batch_wire = append_failure_wire(failure_batch_wire, full_row_wire, should_record_failure_from_fields("full_kv", bench.metrics.exact_match(full_cmp_wire), bench.metrics.contains_target(full_cmp_wire), runtime.decode_loop.parity_match(full_result_wire)))
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_ROW_DONE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " full_kv\n"))
        }
        let paged_row_wire = sample_row_wire_from_timed_result(budget_label, hot_budget_pct, sample_wire, "paged_full_kv", paged_timed_wire, full_result_wire, paged_cmp_wire)
        sample_batch_wire = append_wire(sample_batch_wire, paged_row_wire)
        failure_batch_wire = append_failure_wire(failure_batch_wire, paged_row_wire, should_record_failure_from_fields("paged_full_kv", bench.metrics.exact_match(paged_cmp_wire), bench.metrics.contains_target(paged_cmp_wire), runtime.decode_loop.parity_match(paged_result_wire)))
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_ROW_DONE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " paged_full_kv\n"))
        }
        let recent_row_wire = sample_row_wire_from_timed_result(budget_label, hot_budget_pct, sample_wire, "recent_only", recent_timed_wire, full_result_wire, recent_cmp_wire)
        sample_batch_wire = append_wire(sample_batch_wire, recent_row_wire)
        failure_batch_wire = append_failure_wire(failure_batch_wire, recent_row_wire, should_record_failure_from_fields("recent_only", bench.metrics.exact_match(recent_cmp_wire), bench.metrics.contains_target(recent_cmp_wire), runtime.decode_loop.parity_match(recent_result_wire)))
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_ROW_DONE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " recent_only\n"))
        }
        let quant_row_wire = sample_row_wire_from_timed_result(budget_label, hot_budget_pct, sample_wire, "quantized_old_kv", quant_timed_wire, full_result_wire, quant_cmp_wire)
        sample_batch_wire = append_wire(sample_batch_wire, quant_row_wire)
        failure_batch_wire = append_failure_wire(failure_batch_wire, quant_row_wire, should_record_failure_from_fields("quantized_old_kv", bench.metrics.exact_match(quant_cmp_wire), bench.metrics.contains_target(quant_cmp_wire), runtime.decode_loop.parity_match(quant_result_wire)))
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_ROW_DONE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " quantized_old_kv\n"))
        }
        let fidelity_row_wire = sample_row_wire_from_timed_result(budget_label, hot_budget_pct, sample_wire, "fidelity_paged_kv", fidelity_timed_wire, full_result_wire, fidelity_cmp_wire)
        sample_batch_wire = append_wire(sample_batch_wire, fidelity_row_wire)
        failure_batch_wire = append_failure_wire(failure_batch_wire, fidelity_row_wire, should_record_failure_from_fields("fidelity_paged_kv", bench.metrics.exact_match(fidelity_cmp_wire), bench.metrics.contains_target(fidelity_cmp_wire), runtime.decode_loop.parity_match(fidelity_result_wire)))
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_ROW_DONE sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), " fidelity_paged_kv\n"))
        }
        sample_rows_wire = append_rows_wire(sample_rows_wire, sample_batch_wire)
        failure_rows_wire = append_rows_wire(failure_rows_wire, failure_batch_wire)
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat(str.concat("FPA_TRACE_BENCH_ROWS sample_id=", bench.stress_suite.sample_id_from_wire(sample_wire)), str.concat(" sample_rows=", str.from_i32(collection_count(sample_rows_wire)))), "\n"))
        }
        idx = idx + 1
    }
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_LOOP_DONE sample_rows=", str.from_i32(collection_count(sample_rows_wire))), "\n"))
    }
    let report_wire = benchmark_report_wire_from_rows_wire(budget_label, hot_budget_pct, suite_size, sample_rows_wire)
    let report_json = benchmark_report_json_from_wire_direct(report_wire)
    let prefix = budget_prefix(budget_label)
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_WRITE prefix=", prefix), "\n"))
    }
    discard fs.write_file(str.concat(prefix, "_report_wire.txt"), report_wire)
    discard fs.write_file(str.concat(prefix, "_report_json.txt"), report_json)
    discard fs.write_file(str.concat(prefix, "_samples_wire.txt"), sample_rows_wire)
    discard fs.write_file(str.concat(prefix, "_failures_wire.txt"), failure_rows_wire)
    discard fs.write_file(str.concat(prefix, "_samples_jsonl"), rows_jsonl_from_wire(sample_rows_wire))
    discard fs.write_file(str.concat(prefix, "_failures_jsonl"), rows_jsonl_from_wire(failure_rows_wire))
    discard fs.write_file(str.concat(prefix, "_samples_csv"), str.concat(sample_csv_header(), str.concat("\n", rows_csv_body_from_wire(sample_rows_wire))))
    discard fs.write_file(str.concat(prefix, "_failures_csv"), str.concat(sample_csv_header(), str.concat("\n", rows_csv_body_from_wire(failure_rows_wire))))
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE_BENCH_WRITE_DONE prefix=", prefix), "\n"))
    }
    return BenchmarkArtifacts {
        report: benchmark_report_from_wire(report_wire), sample_rows_wire: sample_rows_wire, failure_rows_wire: failure_rows_wire,
    }
}
fn row_json_from_wire(raw: str) -> str {
    let payload = map.new()
    discard map.set(payload, "budget_label", json.str(frame_value_at(raw, 0)))
    discard map.set(payload, "hot_budget_pct", model.json_emit.i32(parse_decimal(frame_value_at(raw, 1))))
    discard map.set(payload, "sample_id", json.str(frame_value_at(raw, 2)))
    discard map.set(payload, "category", json.str(frame_value_at(raw, 3)))
    discard map.set(payload, "policy_name", json.str(frame_value_at(raw, 4)))
    discard map.set(payload, "prompt_text", json.str(frame_value_at(raw, 5)))
    discard map.set(payload, "target_hint", json.str(frame_value_at(raw, 6)))
    discard map.set(payload, "prompt_token_count", model.json_emit.i32(parse_decimal(frame_value_at(raw, 7))))
    discard map.set(payload, "generated_tokens", model.json_emit.i32(parse_decimal(frame_value_at(raw, 8))))
    discard map.set(payload, "generated_text", json.str(frame_value_at(raw, 9)))
    discard map.set(payload, "generated_token_ids_wire", json.str(frame_value_at(raw, 10)))
    discard map.set(payload, "baseline_generated_text", json.str(frame_value_at(raw, 11)))
    discard map.set(payload, "baseline_generated_token_ids_wire", json.str(frame_value_at(raw, 12)))
    discard map.set(payload, "exact_match", model.json_emit.i32(parse_decimal(frame_value_at(raw, 13))))
    discard map.set(payload, "contains_target", model.json_emit.i32(parse_decimal(frame_value_at(raw, 14))))
    discard map.set(payload, "matching_tokens", model.json_emit.i32(parse_decimal(frame_value_at(raw, 15))))
    discard map.set(payload, "total_tokens", model.json_emit.i32(parse_decimal(frame_value_at(raw, 16))))
    discard map.set(payload, "top1_agreement_pct", model.json_emit.i32(parse_decimal(frame_value_at(raw, 17))))
    discard map.set(payload, "edit_distance", model.json_emit.i32(parse_decimal(frame_value_at(raw, 18))))
    discard map.set(payload, "effective_bytes_total", model.json_emit.i32(parse_decimal(frame_value_at(raw, 19))))
    discard map.set(payload, "block_remap_count_total", model.json_emit.i32(parse_decimal(frame_value_at(raw, 20))))
    discard map.set(payload, "copy_on_write_count_total", model.json_emit.i32(parse_decimal(frame_value_at(raw, 21))))
    discard map.set(payload, "old_pages_streamed_total", model.json_emit.i32(parse_decimal(frame_value_at(raw, 22))))
    discard map.set(payload, "raw_pages_streamed_total", model.json_emit.i32(parse_decimal(frame_value_at(raw, 23))))
    discard map.set(payload, "parity_match", model.json_emit.i32(parse_decimal(frame_value_at(raw, 24))))
    discard map.set(payload, "ttft_ms", model.json_emit.i32(parse_decimal(frame_value_at(raw, 25))))
    discard map.set(payload, "latency_ms", model.json_emit.i32(parse_decimal(frame_value_at(raw, 26))))
    discard map.set(payload, "tokens_per_sec", model.json_emit.i32(parse_decimal(frame_value_at(raw, 27))))
    discard map.set(payload, "steady_tokens_per_sec", model.json_emit.i32(parse_decimal(frame_value_at(raw, 28))))
    return json.object(payload)
}
