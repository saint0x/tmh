fn run_budget_bundle(shape: model.EngineShape, model_dir: str, page_tokens: i32, budget_label: str, hot_budget_pct: i32) -> str {
    discard run_budget_detailed(shape, model_dir, page_tokens, budget_label, hot_budget_pct)
    return budget_bundle_from_written_files(budget_label)
}
fn run_detailed(shape: model.EngineShape, model_dir: str, page_tokens: i32, hot_budget_pct: i32) -> BenchmarkArtifacts {
    return run_budget_detailed(shape, model_dir, page_tokens, str.from_i32(hot_budget_pct), hot_budget_pct)
}
fn run_matrix_detailed(shape: model.EngineShape, model_dir: str, page_tokens: i32, default_hot_budget_pct: i32) -> BenchmarkMatrixArtifacts {
    trace_line("bench_run_begin") let _default_hot_budget_pct = default_hot_budget_pct let settings_count = 5 if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE_BENCH settings_count=", str.from_i32(settings_count)), "\n"))
    }
