ges_streamed_total", model.json_emit.i32(row.raw_pages_streamed_total)) discard map.set(payload, "parity_match", model.json_emit.i32(row.parity_match)) discard map.set(payload, "ttft_ms", model.json_emit.i32(row.ttft_ms)) discard map.set(payload, "latency_ms", model.json_emit.i32(row.latency_ms)) discard map.set(payload, "tokens_per_sec", model.json_emit.i32(row.tokens_per_sec)) discard map.set(payload, "steady_tokens_per_sec", model.json_emit.i32(row.steady_tokens_per_sec)) return json.object(payload)
