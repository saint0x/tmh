fn failure_count_by_budget_and_policy(rows_wire: str, budget_label: str, policy_name: str) -> i32 {
    let row_count = collection_count(rows_wire) let mut total = 0 let mut idx = 0 while idx < row_count {
        let row = sample_row_from_wire(collection_item_at(rows_wire, idx)) if row.budget_label == budget_label && row.policy_name == policy_name {
            total = total + 1
        }
        idx = idx + 1
    }
    return total
}
