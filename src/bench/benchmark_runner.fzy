fn rows_jsonl_from_wire(rows_wire: str) -> str {
    let row_count = collection_count(rows_wire)
    let mut out = ""
    let mut idx = 0
    while idx < row_count {
        let row_wire = collection_item_at(rows_wire, idx)
        out = str.concat(out, row_json_from_wire(row_wire))
        if idx + 1 < row_count {
            out = str.concat(out, "\n")
        }
        idx = idx + 1
    }
    return out
}
fn rows_csv_body_from_wire(rows_wire: str) -> str {
    let row_count = collection_count(rows_wire)
    let mut out = ""
    let mut idx = 0
    while idx < row_count {
        let row_wire = collection_item_at(rows_wire, idx)
        out = str.concat(out, row_csv_from_wire(row_wire))
        if idx + 1 < row_count {
            out = str.concat(out, "\n")
        }
        idx = idx + 1
    }
    return out
