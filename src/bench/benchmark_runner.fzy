al: i32, fidelity_tokens_per_sec_total: i32, fidelity_steady_tokens_per_sec_total: i32) -> str {
    let payload = map.new() discard map.set(payload, "budget_label", json.str(budget_label)) discard map.set(payload, "hot_budget_pct", model.json_emit.i32(hot_budget_pct)) discard map.set(payload, "suite_size", model.json_emit.i32(suite_size)) discard map.set(payload, "full_kv", model.json_emit.raw(aggregate_json_from_full("full_kv", full_sample_count, full_exact_match_count, full_contains_target_count, full_matching_tokens, full_total_tokens, full_effective_bytes_total, full_block_remaps_total, full_old_pages_total, full_raw_pages_total, full_ttft_ms_total, full_latency_ms_total, full_tokens_per_sec_total, full_steady_tokens_per_sec_total))) discard map.set(payload, "paged_full_kv", model.json_emit.raw(aggregate_json_from_full("paged_full_kv", paged_sample_count, paged_exact_match_count, paged_contains_target_count, paged_matching_tokens, paged_total_tokens, paged_effective_bytes_total, paged_block_remaps_total, paged_old_pages_total, paged_raw_pages_total, paged_ttft_ms_total, paged_latency_ms_total, paged_tokens_per_sec_total, paged_steady_tokens_per_sec_total))) discard map.set(payload, "recent_only", model.json_emit.raw(aggregate_json_from_full("recent_only", recent_sample_count, recent_exact_match_count, recent_contains_target_count, recent_matching_tokens, recent_total_tokens, recent_effective_bytes_total, recent_block_remaps_total, recent_old_pages_total, recent_raw_pages_total, recent_ttft_ms_total, recent_latency_ms_total, recent_tokens_per_sec_total, recent_steady_tokens_per_sec_total))) discard map.set(payload, "quantized_old_kv", model.json_emit.raw(aggregate_json_from_full("quantized_old_kv", quant_sample_count, quant_exact_match_count, quant_contains_target_count, quant_matching_tokens, quant_total_tokens, quant_effective_bytes_total, quant_block_remaps_total, quant_old_pages_total, quant_raw_pages_total, quant_ttft_ms_total, quant_latency_ms_total, quant_tokens_per_sec_total, quant_steady_tokens_per_sec_total))) discard map.set(payload, "fidelity_paged_kv", model.json_emit.raw(aggregate_json_from_full("fidelity_paged_kv", fidelity_sample_count, fidelity_exact_match_count, fidelity_contains_target_count, fidelity_matching_tokens, fidelity_total_tokens, fidelity_effective_bytes_total, fidelity_block_remaps_total, fidelity_old_pages_total, fidelity_raw_pages_total, fidelity_ttft_ms_total, fidelity_latency_ms_total, fidelity_tokens_per_sec_total, fidelity_steady_tokens_per_sec_total))) return json.object(payload)
