        let row = bench.benchmark_runner.collection_item_at(failure_rows_wire, idx) next = str.concat(next, str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("- `", row_str(row, 0)), "/"), row_str(row, 4)), str.concat("/", row_str(row, 2))), "` top1="), str.from_i32(row_i32(row, 17))), str.concat("% parity=", str.concat(str.from_i32(row_i32(row, 24)), str.concat(" target=", str.concat(json.str(row_str(row, 6)), "\n")))))) idx = idx + 1 emitted = emitted + 1
    }
    return next
}
