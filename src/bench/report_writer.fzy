    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate_wire_i32(aggregate_wire, 11)))
    out = str.concat(out, ",")
    out = str.concat(out, str.from_i32(aggregate_wire_i32(aggregate_wire, 12)))
