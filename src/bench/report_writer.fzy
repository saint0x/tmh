fn write_matrix_artifacts_from_wire(model_dir: str, page_tokens: i32, budget_reports_wire: str, sample_rows_wire: str, failure_rows_wire: str) -> ArtifactManifest {
    discard fs.mkdir("artifacts") let summary_json_path = matrix_summary_json_path(model_dir) let summary_csv_path = matrix_summary_csv_path(model_dir) let budgets_jsonl_path = matrix_budgets_jsonl_path(model_dir) let samples_jsonl_path = matrix_samples_jsonl_path(model_dir) let samples_csv_path = matrix_samples_csv_path(model_dir) let failures_jsonl_path = matrix_failures_jsonl_path(model_dir) let failures_csv_path = matrix_failures_csv_path(model_dir) let report_md_path = matrix_report_md_path(model_dir) let suite_size = if bench.benchmark_runner.collection_count(budget_reports_wire) <= 0 {
        0
    } else {
        bench.benchmark_runner.benchmark_report_from_wire(bench.benchmark_runner.collection_item_at(budget_reports_wire, 0)).suite_size
    }
    discard fs.write_file(summary_json_path, benchmark_matrix_json_from_wire(budget_reports_wire)) discard fs.write_file(summary_csv_path, matrix_summary_csv_from_wire(budget_reports_wire)) discard fs.write_file(budgets_jsonl_path, budget_reports_jsonl_from_wire(budget_reports_wire)) discard fs.write_file(samples_jsonl_path, rows_jsonl_from_wire(sample_rows_wire)) discard fs.write_file(samples_csv_path, rows_csv(sample_rows_wire)) discard fs.write_file(failures_jsonl_path, rows_jsonl_from_wire(failure_rows_wire)) discard fs.write_file(failures_csv_path, rows_csv(failure_rows_wire)) discard fs.write_file(report_md_path, markdown_matrix_report_from_wire(model_dir, page_tokens, budget_reports_wire, failure_rows_wire)) return ArtifactManifest {
