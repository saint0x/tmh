fn results_md_from_wire_text_fields(model_dir: str, page_tokens: i32, budget_reports_wire: str, failure_rows_wire: str, summary_json_path: str, summary_csv_path: str, budgets_jsonl_path: str, samples_jsonl_path: str, samples_csv_path: str, failures_jsonl_path: str, failures_csv_path: str, report_md_path: str, budget_count: i32) -> str {
    let model_id = model.artifacts.model_id_from_dir(model_dir) let bench_limit = env.get("FPA_BENCH_LIMIT") let suite_size = if bench.benchmark_runner.collection_count(budget_reports_wire) <= 0 {
        0
    } else {
        report_wire_i32(bench.benchmark_runner.collection_item_at(budget_reports_wire, 0), 2)
    }
    let mut rows = "" let mut notes = "" let mut idx = 0 while idx < bench.benchmark_runner.collection_count(budget_reports_wire) {
        let report_wire = bench.benchmark_runner.collection_item_at(budget_reports_wire, idx) let full_wire = report_wire_str(report_wire, 3) let paged_wire = report_wire_str(report_wire, 4) let recent_wire = report_wire_str(report_wire, 5) let quant_wire = report_wire_str(report_wire, 6) let fidelity_wire = report_wire_str(report_wire, 7) rows = str.concat(rows, policy_results_row_from_wire(report_wire, full_wire, failure_rows_wire)) rows = str.concat(rows, policy_results_row_from_wire(report_wire, paged_wire, failure_rows_wire)) rows = str.concat(rows, policy_results_row_from_wire(report_wire, recent_wire, failure_rows_wire)) rows = str.concat(rows, policy_results_row_from_wire(report_wire, quant_wire, failure_rows_wire)) rows = str.concat(rows, policy_results_row_from_wire(report_wire, fidelity_wire, failure_rows_wire)) if aggregate_wire_i32(fidelity_wire, 7) < aggregate_wire_i32(quant_wire, 7) {
            notes = str.concat(notes, str.concat("- fidelity beats quantized_old_kv on effective bytes/token at budget `", str.concat(report_wire_str(report_wire, 0), "`\n")))
        } else {
            notes = str.concat(notes, str.concat("- fidelity does not beat quantized_old_kv on effective bytes/token at budget `", str.concat(report_wire_str(report_wire, 0), "`\n")))
        }
        if aggregate_wire_i32(recent_wire, 6) < aggregate_wire_i32(fidelity_wire, 6) {
            notes = str.concat(notes, str.concat("- recent_only underperforms fidelity at budget `", str.concat(report_wire_str(report_wire, 0), "`\n")))
        } else {
            notes = str.concat(notes, str.concat("- recent_only does not clearly fail versus fidelity at budget `", str.concat(report_wire_str(report_wire, 0), "`\n")))
        }
        idx = idx + 1
    }
    let mut out = "" out = str.concat(out, "# RESULTS\n\n") out = str.concat(out, str.concat("Model: `", str.concat(model_id, "`\n"))) out = str.concat(out, str.concat("Model dir: `", str.concat(model_dir, "`\n"))) out = str.concat(out, str.concat("Hardware: `", str.concat(hardware_label(), "`\n"))) out = str.concat(out, str.concat("Page tokens: `", str.concat(str.from_i32(page_tokens), "`\n"))) out = str.concat(out, str.concat("Suite size: `", str.concat(str.from_i32(suite_size), "`\n"))) out = str.concat(out, str.concat("Budget count: `", str.concat(str.from_i32(budget_count), "`\n"))) out = str.concat(out, "Policies: `full_kv`, `paged_full_kv`, `recent_only`, `quantized_old_kv`, `fidelity_paged_kv`\n") out = str.concat(out, "Budgets: `50`, `25`, `12.5`, `6.25`, `0`\n") if bench_limit != "" {
        out = str.concat(out, str.concat("Bench limit override: `", str.concat(bench_limit, "`\n")))
    }
    out = str.concat(out, "\n## Policy Matrix\n\n") out = str.concat(out, "| Budget | Policy | Samples | Top1 % | Avg Effective Bytes/Token | Avg Remaps | Avg Old Pages | Failure Rows |\n| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: |\n") out = str.concat(out, rows) out = str.concat(out, "\n## Negative Results\n\n") out = str.concat(out, notes) out = str.concat(out, "\n## Failure Cases\n\n") out = append_results_failure_examples(out, failure_rows_wire, 12) out = str.concat(out, "\n## Artifact Paths\n\n") out = str.concat(out, str.concat("- summary.json: `", str.concat(summary_json_path, "`\n"))) out = str.concat(out, str.concat("- summary.csv: `", str.concat(summary_csv_path, "`\n"))) out = str.concat(out, str.concat("- budgets.jsonl: `", str.concat(budgets_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- samples.jsonl: `", str.concat(samples_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- samples.csv: `", str.concat(samples_csv_path, "`\n"))) out = str.concat(out, str.concat("- failures.jsonl: `", str.concat(failures_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- failures.csv: `", str.concat(failures_csv_path, "`\n"))) out = str.concat(out, str.concat("- report.md: `", str.concat(report_md_path, "`\n"))) return out
}
fn results_md_from_wire_text(model_dir: str, page_tokens: i32, budget_reports_wire: str, failure_rows_wire: str, manifest: ArtifactManifest) -> str {
    let model_id = model.artifacts.model_id_from_dir(model_dir) let bench_limit = env.get("FPA_BENCH_LIMIT") let suite_size = if bench.benchmark_runner.collection_count(budget_reports_wire) <= 0 {
        0
    } else {
        bench.benchmark_runner.benchmark_report_from_wire(bench.benchmark_runner.collection_item_at(budget_reports_wire, 0)).suite_size
    }
    let mut rows = "" let mut notes = "" let mut idx = 0 while idx < bench.benchmark_runner.collection_count(budget_reports_wire) {
        let report = bench.benchmark_runner.benchmark_report_from_wire(bench.benchmark_runner.collection_item_at(budget_reports_wire, idx)) rows = str.concat(rows, policy_results_row(report, report.full_kv, failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.paged_full_kv, failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.recent_only, failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.quantized_old_kv, failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.fidelity_paged_kv, failure_rows_wire)) if report.fidelity_paged_kv.avg_effective_bytes_per_token < report.quantized_old_kv.avg_effective_bytes_per_token {
            notes = str.concat(notes, str.concat("- fidelity beats quantized_old_kv on effective bytes/token at budget `", str.concat(report.budget_label, "`\n")))
        } else {
            notes = str.concat(notes, str.concat("- fidelity does not beat quantized_old_kv on effective bytes/token at budget `", str.concat(report.budget_label, "`\n")))
        }
        if report.recent_only.top1_agreement_pct < report.fidelity_paged_kv.top1_agreement_pct {
            notes = str.concat(notes, str.concat("- recent_only underperforms fidelity at budget `", str.concat(report.budget_label, "`\n")))
        } else {
            notes = str.concat(notes, str.concat("- recent_only does not clearly fail versus fidelity at budget `", str.concat(report.budget_label, "`\n")))
        }
        idx = idx + 1
    }
    let mut out = "" out = str.concat(out, "# RESULTS\n\n") out = str.concat(out, str.concat("Model: `", str.concat(model_id, "`\n"))) out = str.concat(out, str.concat("Model dir: `", str.concat(model_dir, "`\n"))) out = str.concat(out, str.concat("Hardware: `", str.concat(hardware_label(), "`\n"))) out = str.concat(out, str.concat("Page tokens: `", str.concat(str.from_i32(page_tokens), "`\n"))) out = str.concat(out, str.concat("Suite size: `", str.concat(str.from_i32(suite_size), "`\n"))) out = str.concat(out, str.concat("Budget count: `", str.concat(str.from_i32(bench.benchmark_runner.collection_count(budget_reports_wire)), "`\n"))) out = str.concat(out, "Policies: `full_kv`, `paged_full_kv`, `recent_only`, `quantized_old_kv`, `fidelity_paged_kv`\n") out = str.concat(out, "Budgets: `50`, `25`, `12.5`, `6.25`, `0`\n") if bench_limit != "" {
        out = str.concat(out, str.concat("Bench limit override: `", str.concat(bench_limit, "`\n")))
    }
    out = str.concat(out, "\n## Policy Matrix\n\n") out = str.concat(out, "| Budget | Policy | Samples | Top1 % | Avg Effective Bytes/Token | Avg Remaps | Avg Old Pages | Failure Rows |\n| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: |\n") out = str.concat(out, rows) out = str.concat(out, "\n## Negative Results\n\n") out = str.concat(out, notes) out = str.concat(out, "\n## Failure Cases\n\n") out = append_results_failure_examples(out, failure_rows_wire, 12) out = str.concat(out, "\n## Artifact Paths\n\n") out = str.concat(out, str.concat("- summary.json: `", str.concat(manifest.summary_json_path, "`\n"))) out = str.concat(out, str.concat("- summary.csv: `", str.concat(manifest.summary_csv_path, "`\n"))) out = str.concat(out, str.concat("- budgets.jsonl: `", str.concat(manifest.budgets_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- samples.jsonl: `", str.concat(manifest.samples_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- samples.csv: `", str.concat(manifest.samples_csv_path, "`\n"))) out = str.concat(out, str.concat("- failures.jsonl: `", str.concat(manifest.failures_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- failures.csv: `", str.concat(manifest.failures_csv_path, "`\n"))) out = str.concat(out, str.concat("- report.md: `", str.concat(manifest.report_md_path, "`\n"))) return out
}
fn write_results_md_from_wire(model_dir: str, page_tokens: i32, budget_reports_wire: str, failure_rows_wire: str, manifest: ArtifactManifest) -> str {
    let output_path = "RESULTS.md" discard fs.write_file(output_path, results_md_from_wire_text(model_dir, page_tokens, budget_reports_wire, failure_rows_wire, manifest)) return output_path
}
fn budget_prefix_path(budget_label: str) -> str {
    return str.concat("artifacts/bench_budget_", bench.benchmark_runner.budget_safe_label(budget_label))
}
fn budget_report_wire_text(budget_label: str) -> str {
    return fs.read_file(str.concat(budget_prefix_path(budget_label), "_report_wire.txt"))
}
fn budget_sample_rows_wire_text(budget_label: str) -> str {
    return fs.read_file(str.concat(budget_prefix_path(budget_label), "_samples_wire.txt"))
}
fn budget_failure_rows_wire_text(budget_label: str) -> str {
    return fs.read_file(str.concat(budget_prefix_path(budget_label), "_failures_wire.txt"))
}
fn run_bench_output_text(shape: model.EngineShape, model_dir: str, page_tokens: i32, hot_budget_pct: i32) -> str {
    let bundle = bench.benchmark_runner.run_matrix_bundle(shape, model_dir, page_tokens, hot_budget_pct)
    let budget_reports_wire = bench.benchmark_runner.matrix_budget_reports_wire(bundle)
    let sample_rows_wire = bench.benchmark_runner.matrix_sample_rows_wire(bundle)
    let failure_rows_wire = bench.benchmark_runner.matrix_failure_rows_wire(bundle)
    let manifest_json = write_matrix_outputs_manifest_json_from_wire(model_dir, page_tokens, budget_reports_wire, sample_rows_wire, failure_rows_wire)
    return str.concat(str.concat(str.concat("FPA_BENCH ", benchmark_matrix_json_from_wire(budget_reports_wire)), "\n"), str.concat(str.concat("FPA_BENCH_ARTIFACTS ", manifest_json), "\n"))
}
fn write_matrix_outputs_manifest_json_from_wire(model_dir: str, page_tokens: i32, budget_reports_wire: str, sample_rows_wire: str, failure_rows_wire: str) -> str {
    discard fs.mkdir("artifacts")
    let summary_json_path = matrix_summary_json_path(model_dir)
    let summary_csv_path = matrix_summary_csv_path(model_dir)
    let budgets_jsonl_path = matrix_budgets_jsonl_path(model_dir)
    let samples_jsonl_path = matrix_samples_jsonl_path(model_dir)
    let samples_csv_path = matrix_samples_csv_path(model_dir)
    let failures_jsonl_path = matrix_failures_jsonl_path(model_dir)
    let failures_csv_path = matrix_failures_csv_path(model_dir)
    let report_md_path = matrix_report_md_path(model_dir)
    let budget_count = bench.benchmark_runner.collection_count(budget_reports_wire)
    let suite_size = if budget_count <= 0 {
        0
    } else {
        report_wire_i32(bench.benchmark_runner.collection_item_at(budget_reports_wire, 0), 2)
    }
    let sample_rows = bench.benchmark_runner.collection_count(sample_rows_wire)
    let failure_rows = bench.benchmark_runner.collection_count(failure_rows_wire)
    discard fs.write_file(summary_json_path, benchmark_matrix_json_from_wire(budget_reports_wire))
    discard fs.write_file(summary_csv_path, matrix_summary_csv_from_wire(budget_reports_wire))
    discard fs.write_file(budgets_jsonl_path, budget_reports_jsonl_from_wire(budget_reports_wire))
    discard fs.write_file(samples_jsonl_path, rows_jsonl_from_wire(sample_rows_wire))
    discard fs.write_file(samples_csv_path, rows_csv_direct(sample_rows_wire))
    discard fs.write_file(failures_jsonl_path, rows_jsonl_from_wire(failure_rows_wire))
    discard fs.write_file(failures_csv_path, rows_csv_direct(failure_rows_wire))
    discard fs.write_file(report_md_path, markdown_matrix_report_from_wire(model_dir, page_tokens, budget_reports_wire, failure_rows_wire))
    discard fs.write_file("RESULTS.md", results_md_from_wire_text_fields(model_dir, page_tokens, budget_reports_wire, failure_rows_wire, summary_json_path, summary_csv_path, budgets_jsonl_path, samples_jsonl_path, samples_csv_path, failures_jsonl_path, failures_csv_path, report_md_path, budget_count))
    return manifest_json(ArtifactManifest {
        summary_json_path: summary_json_path, summary_csv_path: summary_csv_path, budgets_jsonl_path: budgets_jsonl_path, samples_jsonl_path: samples_jsonl_path, samples_csv_path: samples_csv_path, failures_jsonl_path: failures_jsonl_path, failures_csv_path: failures_csv_path, report_md_path: report_md_path, budget_count: budget_count, suite_size: suite_size, sample_rows: sample_rows, failure_rows: failure_rows,
    })
}
fn policy_results_row(report: bench.benchmark_runner.BenchmarkReport, aggregate: bench.benchmark_runner.PolicyAggregate, failure_rows_wire: str) -> str {
    return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("| ", report.budget_label), str.concat(" | ", aggregate.policy_name)), str.concat(" | ", str.from_i32(aggregate.sample_count))), str.concat(" | ", str.from_i32(aggregate.top1_agreement_pct))), str.concat(" | ", str.from_i32(aggregate.avg_effective_bytes_per_token))), str.concat(" | ", str.from_i32(aggregate.avg_block_remaps_per_sample))), str.concat(" | ", str.from_i32(aggregate.avg_old_pages_streamed))), str.concat(str.concat(" | ", str.from_i32(failure_count_by_budget_and_policy_direct(failure_rows_wire, report.budget_label, aggregate.policy_name))), " |\n"))
}
fn append_results_failure_examples(out: str, failure_rows_wire: str, limit: i32) -> str {
    if bench.benchmark_runner.collection_count(failure_rows_wire) <= 0 {
        return str.concat(out, "- none\n")
    }
    let mut next = out let mut idx = 0 while idx < bench.benchmark_runner.collection_count(failure_rows_wire) && idx < limit {
        let row = bench.benchmark_runner.collection_item_at(failure_rows_wire, idx) next = str.concat(next, str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("- `", row_str(row, 0)), "/"), row_str(row, 4)), str.concat("/", row_str(row, 2))), "` top1="), str.from_i32(row_i32(row, 17))), str.concat("% parity=", str.concat(str.from_i32(row_i32(row, 24)), str.concat(" target=", str.concat(json.str(row_str(row, 6)), "\n")))))) idx = idx + 1
    }
    return next
}
fn results_md(model_dir: str, page_tokens: i32, artifacts: bench.benchmark_runner.BenchmarkMatrixArtifacts, manifest: ArtifactManifest) -> str {
    let model_id = model.artifacts.model_id_from_dir(model_dir) let bench_limit = env.get("FPA_BENCH_LIMIT") let suite_size = if bench.benchmark_runner.collection_count(artifacts.budget_reports_wire) <= 0 {
        0
    } else {
        bench.benchmark_runner.benchmark_report_from_wire(bench.benchmark_runner.collection_item_at(artifacts.budget_reports_wire, 0)).suite_size
    }
    let mut rows = "" let mut notes = "" let mut idx = 0 while idx < bench.benchmark_runner.collection_count(artifacts.budget_reports_wire) {
        let report = bench.benchmark_runner.benchmark_report_from_wire(bench.benchmark_runner.collection_item_at(artifacts.budget_reports_wire, idx)) rows = str.concat(rows, policy_results_row(report, report.full_kv, artifacts.failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.paged_full_kv, artifacts.failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.recent_only, artifacts.failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.quantized_old_kv, artifacts.failure_rows_wire)) rows = str.concat(rows, policy_results_row(report, report.fidelity_paged_kv, artifacts.failure_rows_wire)) if report.fidelity_paged_kv.avg_effective_bytes_per_token < report.quantized_old_kv.avg_effective_bytes_per_token {
            notes = str.concat(notes, str.concat("- fidelity beats quantized_old_kv on effective bytes/token at budget `", str.concat(report.budget_label, "`\n")))
        } else {
            notes = str.concat(notes, str.concat("- fidelity does not beat quantized_old_kv on effective bytes/token at budget `", str.concat(report.budget_label, "`\n")))
        }
        if report.recent_only.top1_agreement_pct < report.fidelity_paged_kv.top1_agreement_pct {
            notes = str.concat(notes, str.concat("- recent_only underperforms fidelity at budget `", str.concat(report.budget_label, "`\n")))
        } else {
            notes = str.concat(notes, str.concat("- recent_only does not clearly fail versus fidelity at budget `", str.concat(report.budget_label, "`\n")))
        }
        idx = idx + 1
    }
    let mut out = "" out = str.concat(out, "# RESULTS\n\n") out = str.concat(out, str.concat("Model: `", str.concat(model_id, "`\n"))) out = str.concat(out, str.concat("Model dir: `", str.concat(model_dir, "`\n"))) out = str.concat(out, str.concat("Hardware: `", str.concat(hardware_label(), "`\n"))) out = str.concat(out, str.concat("Page tokens: `", str.concat(str.from_i32(page_tokens), "`\n"))) out = str.concat(out, str.concat("Suite size: `", str.concat(str.from_i32(suite_size), "`\n"))) out = str.concat(out, str.concat("Budget count: `", str.concat(str.from_i32(artifacts.budget_count), "`\n"))) out = str.concat(out, "Policies: `full_kv`, `paged_full_kv`, `recent_only`, `quantized_old_kv`, `fidelity_paged_kv`\n") out = str.concat(out, "Budgets: `50`, `25`, `12.5`, `6.25`, `0`\n") if bench_limit != "" {
        out = str.concat(out, str.concat("Bench limit override: `", str.concat(bench_limit, "`\n")))
    }
    out = str.concat(out, "\n## Policy Matrix\n\n") out = str.concat(out, "| Budget | Policy | Samples | Top1 % | Avg Effective Bytes/Token | Avg Remaps | Avg Old Pages | Failure Rows |\n| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: |\n") out = str.concat(out, rows) out = str.concat(out, "\n## Negative Results\n\n") out = str.concat(out, notes) out = str.concat(out, "\n## Failure Cases\n\n") out = append_results_failure_examples(out, artifacts.failure_rows_wire, 12) out = str.concat(out, "\n## Artifact Paths\n\n") out = str.concat(out, str.concat("- summary.json: `", str.concat(manifest.summary_json_path, "`\n"))) out = str.concat(out, str.concat("- summary.csv: `", str.concat(manifest.summary_csv_path, "`\n"))) out = str.concat(out, str.concat("- budgets.jsonl: `", str.concat(manifest.budgets_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- samples.jsonl: `", str.concat(manifest.samples_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- samples.csv: `", str.concat(manifest.samples_csv_path, "`\n"))) out = str.concat(out, str.concat("- failures.jsonl: `", str.concat(manifest.failures_jsonl_path, "`\n"))) out = str.concat(out, str.concat("- failures.csv: `", str.concat(manifest.failures_csv_path, "`\n"))) out = str.concat(out, str.concat("- report.md: `", str.concat(manifest.report_md_path, "`\n"))) return out
}
fn write_results_md(model_dir: str, page_tokens: i32, artifacts: bench.benchmark_runner.BenchmarkMatrixArtifacts, manifest: ArtifactManifest) -> str {
    let output_path = "RESULTS.md" discard fs.write_file(output_path, results_md(model_dir, page_tokens, artifacts, manifest)) return output_path
}
