use core.env;
use core.fs;
use core.path;
use bench.benchmark_runner;
use bench.stress_suite;
use model;
struct ArtifactManifest {
    summary_json_path: str, summary_csv_path: str, budgets_jsonl_path: str, samples_jsonl_path: str, samples_csv_path: str, failures_jsonl_path: str, failures_csv_path: str, report_md_path: str, budget_count: i32, suite_size: i32, sample_rows: i32, failure_rows: i32,
}
fn trace_enabled() -> i32 {
    if env.get("FPA_TRACE_RUNTIME") == "1" {
        return 1
    }
    return 0
}
fn trace_line(label: str) {
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE_WRITER ", label), "\n"))
    }
}
fn aggregate_json(report: bench.benchmark_runner.PolicyAggregate) -> str {
    let payload = map.new() discard map.set(payload, "policy", json.str(report.policy_name)) discard map.set(payload, "sample_count", model.json_emit.i32(report.sample_count)) discard map.set(payload, "exact_match_count", model.json_emit.i32(report.exact_match_count)) discard map.set(payload, "contains_target_count", model.json_emit.i32(report.contains_target_count)) discard map.set(payload, "matching_tokens", model.json_emit.i32(report.matching_tokens)) discard map.set(payload, "total_tokens", model.json_emit.i32(report.total_tokens)) discard map.set(payload, "top1_agreement_pct", model.json_emit.i32(report.top1_agreement_pct)) discard map.set(payload, "avg_effective_bytes_per_token", model.json_emit.i32(report.avg_effective_bytes_per_token)) discard map.set(payload, "avg_block_remaps_per_sample", model.json_emit.i32(report.avg_block_remaps_per_sample)) discard map.set(payload, "avg_old_pages_streamed", model.json_emit.i32(report.avg_old_pages_streamed)) discard map.set(payload, "avg_raw_pages_streamed", model.json_emit.i32(report.avg_raw_pages_streamed)) discard map.set(payload, "avg_ttft_ms", model.json_emit.i32(report.avg_ttft_ms)) discard map.set(payload, "avg_latency_ms", model.json_emit.i32(report.avg_latency_ms)) discard map.set(payload, "avg_tokens_per_sec", model.json_emit.i32(report.avg_tokens_per_sec)) discard map.set(payload, "avg_steady_tokens_per_sec", model.json_emit.i32(report.avg_steady_tokens_per_sec)) return json.object(payload)
}
fn benchmark_json(report: bench.benchmark_runner.BenchmarkReport) -> str {
    let payload = map.new() discard map.set(payload, "budget_label", json.str(report.budget_label)) discard map.set(payload, "hot_budget_pct", model.json_emit.i32(report.hot_budget_pct)) discard map.set(payload, "suite_size", model.json_emit.i32(report.suite_size)) discard map.set(payload, "full_kv", model.json_emit.raw(aggregate_json(report.full_kv))) discard map.set(payload, "paged_full_kv", model.json_emit.raw(aggregate_json(report.paged_full_kv))) discard map.set(payload, "recent_only", model.json_emit.raw(aggregate_json(report.recent_only))) discard map.set(payload, "quantized_old_kv", model.json_emit.raw(aggregate_json(report.quantized_old_kv))) discard map.set(payload, "fidelity_paged_kv", model.json_emit.raw(aggregate_json(report.fidelity_paged_kv))) return json.object(payload)
}
fn budget_reports_jsonl_from_wire(budget_reports_wire: str) -> str {
    let total = bench.benchmark_runner.collection_count(budget_reports_wire)
    let mut out = ""
    let mut idx = 0
    while idx < total {
        let report_wire = bench.benchmark_runner.collection_item_at(budget_reports_wire, idx)
        out = str.concat(out, bench.benchmark_runner.benchmark_report_json_from_wire_direct(report_wire))
        if idx + 1 < total {
            out = str.concat(out, "\n")
        }
        idx = idx + 1
    }
    return out
}
fn rows_jsonl_from_wire(rows_wire: str) -> str {
    let total = bench.benchmark_runner.collection_count(rows_wire)
    let mut out = ""
    let mut idx = 0
    while idx < total {
        let row_wire = bench.benchmark_runner.collection_item_at(rows_wire, idx)
        out = str.concat(out, bench.benchmark_runner.row_json_from_wire(row_wire))
        if idx + 1 < total {
            out = str.concat(out, "\n")
        }
        idx = idx + 1
    }
    return out
}
fn row_str(raw: str, position: i32) -> str {
    return benchmark_runner.frame_value_at(raw, position)
}
fn row_i32(raw: str, position: i32) -> i32 {
    return benchmark_runner.parse_decimal(row_str(raw, position))
}
fn row_json_from_wire(raw: str) -> str {
    return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("{\"budget_label\":", json.str(row_str(raw, 0))), str.concat(",\"hot_budget_pct\":", str.from_i32(row_i32(raw, 1)))), str.concat(",\"sample_id\":", json.str(row_str(raw, 2)))), str.concat(",\"category\":", json.str(row_str(raw, 3)))), str.concat(",\"policy_name\":", json.str(row_str(raw, 4)))), str.concat(",\"prompt_text\":", json.str(row_str(raw, 5)))), str.concat(",\"target_hint\":", json.str(row_str(raw, 6)))), str.concat(",\"prompt_token_count\":", str.from_i32(row_i32(raw, 7)))), str.concat(",\"generated_tokens\":", str.from_i32(row_i32(raw, 8)))), str.concat(",\"generated_text\":", json.str(row_str(raw, 9)))), str.concat(",\"generated_token_ids_wire\":", json.str(row_str(raw, 10)))), str.concat(",\"baseline_generated_text\":", json.str(row_str(raw, 11)))), str.concat(",\"baseline_generated_token_ids_wire\":", json.str(row_str(raw, 12)))), str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(",\"exact_match\":", str.from_i32(row_i32(raw, 13))), str.concat(",\"contains_target\":", str.from_i32(row_i32(raw, 14)))), str.concat(",\"matching_tokens\":", str.from_i32(row_i32(raw, 15)))), str.concat(",\"total_tokens\":", str.from_i32(row_i32(raw, 16)))), str.concat(",\"top1_agreement_pct\":", str.from_i32(row_i32(raw, 17)))), str.concat(",\"edit_distance\":", str.from_i32(row_i32(raw, 18))))), str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(",\"effective_bytes_total\":", str.from_i32(row_i32(raw, 19))), str.concat(",\"block_remap_count_total\":", str.from_i32(row_i32(raw, 20)))), str.concat(",\"copy_on_write_count_total\":", str.from_i32(row_i32(raw, 21)))), str.concat(",\"old_pages_streamed_total\":", str.from_i32(row_i32(raw, 22)))), str.concat(",\"raw_pages_streamed_total\":", str.from_i32(row_i32(raw, 23)))), str.concat(str.concat(",\"parity_match\":", str.from_i32(row_i32(raw, 24))), "}"))), "")
}
fn rows_jsonl_direct(rows_wire: str) -> str {
    let mut out = "" let mut idx = 0 while idx < bench.benchmark_runner.collection_count(rows_wire) {
        out = str.concat(out, row_json_from_wire(bench.benchmark_runner.collection_item_at(rows_wire, idx))) if idx + 1 < bench.benchmark_runner.collection_count(rows_wire) {
            out = str.concat(out, "\n")
        }
        idx = idx + 1
    }
    return out
}
fn benchmark_matrix_json(artifacts: bench.benchmark_runner.BenchmarkMatrixArtifacts) -> str {
    let mut rows = "" let mut idx = 0 while idx < bench.benchmark_runner.collection_count(artifacts.budget_reports_wire) {
        if idx > 0 {
            rows = str.concat(rows, ",")
        }
        rows = str.concat(rows, benchmark_json(bench.benchmark_runner.benchmark_report_from_wire(bench.benchmark_runner.collection_item_at(artifacts.budget_reports_wire, idx)))) idx = idx + 1
    }
    let mut out = "{\"budget_count\":"
    out = str.concat(out, str.from_i32(artifacts.budget_count))
    out = str.concat(out, ",\"budgets\":[")
    out = str.concat(out, rows)
    out = str.concat(out, "]}")
    return out
}
fn benchmark_matrix_json_from_wire(budget_reports_wire: str) -> str {
    let total = bench.benchmark_runner.collection_count(budget_reports_wire)
    let mut rows = ""
    let mut idx = 0
    while idx < total {
        let report_wire = bench.benchmark_runner.collection_item_at(budget_reports_wire, idx)
        if idx > 0 {
            rows = str.concat(rows, ",")
        }
        rows = str.concat(rows, bench.benchmark_runner.benchmark_report_json_from_wire_direct(report_wire))
        idx = idx + 1
    }
    let mut out = "{\"budget_count\":"
    out = str.concat(out, str.from_i32(total))
    out = str.concat(out, ",\"budgets\":[")
    out = str.concat(out, rows)
    out = str.concat(out, "]}")
    return out
}
fn benchmark_matrix_json_from_jsonl(budget_reports_jsonl: str) -> str {
    let mut rows = "" let mut idx = 0 let budget_count = bench.stress_suite.count(budget_reports_jsonl) while idx < budget_count {
        if idx > 0 {
            rows = str.concat(rows, ",")
        }
        rows = str.concat(rows, bench.stress_suite.item_at(budget_reports_jsonl, idx)) idx = idx + 1
    }
    return str.concat(str.concat(str.concat("{\"budget_count\":", str.from_i32(budget_count)), ",\"budgets\":["), str.concat(rows, "]}"))
}
fn sanitize_csv(text: str) -> str {
    let mut out = "" let mut idx = 0 while idx < str.len(text) {
        let ch = str.slice(text, idx, idx + 1) if ch == "," || ch == "\n" || ch == "\r" {
            out = str.concat(out, " ")
        } else if ch == "\"" {
            out = str.concat(out, "'")
        } else {
            out = str.concat(out, ch)
        }
        idx = idx + 1
    }
    return out
}
