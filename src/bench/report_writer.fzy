    return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("| ", report_wire_str(report_wire, 0)), str.concat(" | ", aggregate_wire_str(aggregate_wire, 0))), str.concat(" | ", str.from_i32(aggregate_wire_i32(aggregate_wire, 1)))), str.concat(" | ", str.from_i32(aggregate_wire_i32(aggregate_wire, 6)))), str.concat(" | ", str.from_i32(aggregate_wire_i32(aggregate_wire, 7)))), str.concat(" | ", str.from_i32(aggregate_wire_i32(aggregate_wire, 8)))), str.concat(" | ", str.from_i32(aggregate_wire_i32(aggregate_wire, 9)))), str.concat(str.concat(" | ", str.from_i32(failure_count_by_budget_and_policy_direct(failure_rows_wire, report_wire_str(report_wire, 0), aggregate_wire_str(aggregate_wire, 0)))), " |\n"))
