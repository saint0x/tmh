    discard fs.mkdir("artifacts") let prefix = str.concat(str.concat("fpa_bench_", model.artifacts.model_id_from_dir(model_dir)), str.concat("_hot", str.from_i32(hot_budget_pct))) let summary_json_path = path.join("artifacts", str.concat(prefix, ".summary.json")) let summary_csv_path = path.join("artifacts", str.concat(prefix, ".summary.csv")) let budgets_jsonl_path = path.join("artifacts", str.concat(prefix, ".budgets.jsonl")) let samples_jsonl_path = path.join("artifacts", str.concat(prefix, ".samples.jsonl")) let samples_csv_path = path.join("artifacts", str.concat(prefix, ".samples.csv")) let failures_jsonl_path = path.join("artifacts", str.concat(prefix, ".failures.jsonl")) let failures_csv_path = path.join("artifacts", str.concat(prefix, ".failures.csv")) let report_md_path = path.join("artifacts", str.concat(prefix, ".report.md")) discard fs.write_file(summary_json_path, benchmark_json(artifacts.report)) discard fs.write_file(summary_csv_path, summary_csv(artifacts.report)) discard fs.write_file(budgets_jsonl_path, benchmark_json(artifacts.report)) discard fs.write_file(samples_jsonl_path, rows_jsonl_from_wire(artifacts.sample_rows_wire)) discard fs.write_file(samples_csv_path, rows_csv(artifacts.sample_rows_wire)) discard fs.write_file(failures_jsonl_path, rows_jsonl_from_wire(artifacts.failure_rows_wire)) discard fs.write_file(failures_csv_path, rows_csv(artifacts.failure_rows_wire)) let matrix_artifacts = bench.benchmark_runner.matrix_artifacts_from_budget(artifacts) discard fs.write_file(report_md_path, markdown_matrix_report(model_dir, page_tokens, matrix_artifacts)) return ArtifactManifest {
        summary_json_path: summary_json_path, summary_csv_path: summary_csv_path, budgets_jsonl_path: budgets_jsonl_path, samples_jsonl_path: samples_jsonl_path, samples_csv_path: samples_csv_path, failures_jsonl_path: failures_jsonl_path, failures_csv_path: failures_csv_path, report_md_path: report_md_path, budget_count: 1, suite_size: artifacts.report.suite_size, sample_rows: bench.benchmark_runner.collection_count(artifacts.sample_rows_wire), failure_rows: bench.benchmark_runner.collection_count(artifacts.failure_rows_wire),
    }
