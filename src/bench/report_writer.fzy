fn summary_csv(report: bench.benchmark_runner.BenchmarkReport) -> str {
    let header = "budget_label,hot_budget_pct,policy,sample_count,exact_match_count,contains_target_count,matching_tokens,total_tokens,top1_agreement_pct,avg_effective_bytes_per_token,avg_block_remaps_per_sample,avg_old_pages_streamed,avg_raw_pages_streamed,avg_ttft_ms,avg_latency_ms,avg_tokens_per_sec,avg_steady_tokens_per_sec" return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(header, "\n"), aggregate_csv_row(report, report.full_kv)), str.concat("\n", aggregate_csv_row(report, report.paged_full_kv))), str.concat("\n", aggregate_csv_row(report, report.recent_only))), str.concat("\n", aggregate_csv_row(report, report.quantized_old_kv))), str.concat("\n", aggregate_csv_row(report, report.fidelity_paged_kv))), "\n")
}
fn matrix_summary_csv(artifacts: bench.benchmark_runner.BenchmarkMatrixArtifacts) -> str {
    let header = "budget_label,hot_budget_pct,policy,sample_count,exact_match_count,contains_target_count,matching_tokens,total_tokens,top1_agreement_pct,avg_effective_bytes_per_token,avg_block_remaps_per_sample,avg_old_pages_streamed,avg_raw_pages_streamed,avg_ttft_ms,avg_latency_ms,avg_tokens_per_sec,avg_steady_tokens_per_sec" let mut out = str.concat(header, "\n") let mut idx = 0 while idx < bench.benchmark_runner.collection_count(artifacts.budget_reports_wire) {
        let budget_report = bench.benchmark_runner.benchmark_report_from_wire(bench.benchmark_runner.collection_item_at(artifacts.budget_reports_wire, idx)) out = str.concat(out, aggregate_csv_row(budget_report, budget_report.full_kv)) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row(budget_report, budget_report.paged_full_kv)) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row(budget_report, budget_report.recent_only)) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row(budget_report, budget_report.quantized_old_kv)) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row(budget_report, budget_report.fidelity_paged_kv)) out = str.concat(out, "\n") idx = idx + 1
    }
    return out
}
fn matrix_summary_csv_from_wire(budget_reports_wire: str) -> str {
    let header = "budget_label,hot_budget_pct,policy,sample_count,exact_match_count,contains_target_count,matching_tokens,total_tokens,top1_agreement_pct,avg_effective_bytes_per_token,avg_block_remaps_per_sample,avg_old_pages_streamed,avg_raw_pages_streamed,avg_ttft_ms,avg_latency_ms,avg_tokens_per_sec,avg_steady_tokens_per_sec" let mut out = str.concat(header, "\n") let mut idx = 0 while idx < bench.benchmark_runner.collection_count(budget_reports_wire) {
        let report_wire = bench.benchmark_runner.collection_item_at(budget_reports_wire, idx) let budget_label = bench.benchmark_runner.frame_value_at(report_wire, 0) let hot_budget_pct = bench.benchmark_runner.parse_decimal(bench.benchmark_runner.frame_value_at(report_wire, 1)) out = str.concat(out, aggregate_csv_row_from_wire(budget_label, hot_budget_pct, bench.benchmark_runner.frame_value_at(report_wire, 3))) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row_from_wire(budget_label, hot_budget_pct, bench.benchmark_runner.frame_value_at(report_wire, 4))) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row_from_wire(budget_label, hot_budget_pct, bench.benchmark_runner.frame_value_at(report_wire, 5))) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row_from_wire(budget_label, hot_budget_pct, bench.benchmark_runner.frame_value_at(report_wire, 6))) out = str.concat(out, "\n") out = str.concat(out, aggregate_csv_row_from_wire(budget_label, hot_budget_pct, bench.benchmark_runner.frame_value_at(report_wire, 7))) out = str.concat(out, "\n") idx = idx + 1
    }
    return out
}
fn sample_csv_header() -> str {
    return "budget_label,hot_budget_pct,sample_id,category,policy_name,prompt_token_count,generated_tokens,exact_match,contains_target,matching_tokens,total_tokens,top1_agreement_pct,edit_distance,effective_bytes_total,block_remap_count_total,copy_on_write_count_total,old_pages_streamed_total,raw_pages_streamed_total,parity_match,target_hint,generated_text"
}
fn sample_csv_row(row: bench.benchmark_runner.SampleRow) -> str {
    let mut out = "" out = str.concat(out, sanitize_csv(row.budget_label)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.hot_budget_pct)) out = str.concat(out, ",") out = str.concat(out, sanitize_csv(row.sample_id)) out = str.concat(out, ",") out = str.concat(out, sanitize_csv(row.category)) out = str.concat(out, ",") out = str.concat(out, sanitize_csv(row.policy_name)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.prompt_token_count)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.generated_tokens)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.exact_match)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.contains_target)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.matching_tokens)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.total_tokens)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.top1_agreement_pct)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.edit_distance)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.effective_bytes_total)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.block_remap_count_total)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.copy_on_write_count_total)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.old_pages_streamed_total)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.raw_pages_streamed_total)) out = str.concat(out, ",") out = str.concat(out, str.from_i32(row.parity_match)) out = str.concat(out, ",") out = str.concat(out, sanitize_csv(row.target_hint)) out = str.concat(out, ",") out = str.concat(out, sanitize_csv(row.generated_text)) return out
}
fn rows_csv(rows_wire: str) -> str {
    let mut out = str.concat(sample_csv_header(), "\n") let mut idx = 0 while idx < bench.benchmark_runner.collection_count(rows_wire) {
        let row = bench.benchmark_runner.sample_row_from_wire(bench.benchmark_runner.collection_item_at(rows_wire, idx)) out = str.concat(out, sample_csv_row(row)) out = str.concat(out, "\n") idx = idx + 1
    }
    return out
}
fn rows_csv_body(rows_wire: str) -> str {
    let mut out = "" let mut idx = 0 while idx < bench.benchmark_runner.collection_count(rows_wire) {
        let row = bench.benchmark_runner.sample_row_from_wire(bench.benchmark_runner.collection_item_at(rows_wire, idx)) out = str.concat(out, sample_csv_row(row)) out = str.concat(out, "\n") idx = idx + 1
    }
    return out
