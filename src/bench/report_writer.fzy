}
fn aggregate_wire_str(raw: str, position: i32) -> str {
    return benchmark_runner.frame_value_at(raw, position)
}
fn aggregate_wire_i32(raw: str, position: i32) -> i32 {
    return benchmark_runner.parse_decimal(aggregate_wire_str(raw, position))
}
fn report_wire_str(raw: str, position: i32) -> str {
    return benchmark_runner.frame_value_at(raw, position)
}
fn report_wire_i32(raw: str, position: i32) -> i32 {
