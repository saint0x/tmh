use core.env;
use attention;
use model;
use runtime.session;
struct AttentionRuntimeReport {
    policy_name: str, prompt_tokens: i32, decode_tokens: i32, used_pages: i32, target_token: i32, target_layer: i32, attn_sum_x1000: i32, output_sum_x1000: i32, top_page: i32, top_score_x1000: i32, effective_bytes_read: i32, old_pages_streamed: i32, raw_pages_streamed: i32, parity_match: i32,
}
fn trace_enabled() -> i32 {
    if env.get("FPA_TRACE_RUNTIME") == "1" {
        return 1
    }
    return 0
}
fn trace_line(label: str) {
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat("FPA_TRACE ", label), "\n"))
    }
}
fn parity_enabled() -> i32 {
    if env.get("FPA_ENABLE_PARITY") == "1" {
        return 1
    }
    return 0
}
fn frame_push(wire: str, value: str) -> str {
    return runtime.block_manager.frame_push(wire, value)
}
fn frame_value_at(wire: str, position: i32) -> str {
    return runtime.block_manager.frame_value_at(wire, position)
}
fn report_wire(policy_name: str, prompt_tokens: i32, decode_tokens: i32, used_pages: i32, target_token: i32, target_layer: i32, attn_sum_x1000: i32, output_sum_x1000: i32, top_page: i32, top_score_x1000: i32, effective_bytes_read: i32, old_pages_streamed: i32, raw_pages_streamed: i32, parity_match: i32) -> str {
    let mut wire = "" wire = frame_push(wire, policy_name) wire = frame_push(wire, str.from_i32(prompt_tokens)) wire = frame_push(wire, str.from_i32(decode_tokens)) wire = frame_push(wire, str.from_i32(used_pages)) wire = frame_push(wire, str.from_i32(target_token)) wire = frame_push(wire, str.from_i32(target_layer)) wire = frame_push(wire, str.from_i32(attn_sum_x1000)) wire = frame_push(wire, str.from_i32(output_sum_x1000)) wire = frame_push(wire, str.from_i32(top_page)) wire = frame_push(wire, str.from_i32(top_score_x1000)) wire = frame_push(wire, str.from_i32(effective_bytes_read)) wire = frame_push(wire, str.from_i32(old_pages_streamed)) wire = frame_push(wire, str.from_i32(raw_pages_streamed)) wire = frame_push(wire, str.from_i32(parity_match)) return wire
}
fn metrics_wire(effective_bytes_read: i32, old_pages_streamed: i32, raw_pages_streamed: i32, parity_match: i32) -> str {
    let mut wire = ""
    wire = frame_push(wire, str.from_i32(effective_bytes_read))
    wire = frame_push(wire, str.from_i32(old_pages_streamed))
    wire = frame_push(wire, str.from_i32(raw_pages_streamed))
    wire = frame_push(wire, str.from_i32(parity_match))
    return wire
}
fn str_field(wire: str, position: i32) -> str {
    return frame_value_at(wire, position)
}
fn i32_field(wire: str, position: i32) -> i32 {
    return model.artifacts.parse_i32(frame_value_at(wire, position))
}
fn metrics_effective_bytes_read(wire: str) -> i32 {
    return i32_field(wire, 0)
}
fn metrics_old_pages_streamed(wire: str) -> i32 {
    return i32_field(wire, 1)
}
fn metrics_raw_pages_streamed(wire: str) -> i32 {
    return i32_field(wire, 2)
}
fn metrics_parity_match(wire: str) -> i32 {
    return i32_field(wire, 3)
}
fn from_wire(wire: str) -> AttentionRuntimeReport {
    return AttentionRuntimeReport {
        policy_name: str_field(wire, 0), prompt_tokens: i32_field(wire, 1), decode_tokens: i32_field(wire, 2), used_pages: i32_field(wire, 3), target_token: i32_field(wire, 4), target_layer: i32_field(wire, 5), attn_sum_x1000: i32_field(wire, 6), output_sum_x1000: i32_field(wire, 7), top_page: i32_field(wire, 8), top_score_x1000: i32_field(wire, 9), effective_bytes_read: i32_field(wire, 10), old_pages_streamed: i32_field(wire, 11), raw_pages_streamed: i32_field(wire, 12), parity_match: i32_field(wire, 13),
    }
}
fn from_attention_report(report: attention.AttentionReport, parity_match: i32) -> AttentionRuntimeReport {
    return AttentionRuntimeReport {
        policy_name: report.policy_name, prompt_tokens: report.prompt_tokens, decode_tokens: report.decode_tokens, used_pages: report.used_pages, target_token: report.target_token, target_layer: report.target_layer, attn_sum_x1000: report.attn_sum_x1000, output_sum_x1000: report.output_sum_x1000, top_page: report.top_page, top_score_x1000: report.top_score_x1000, effective_bytes_read: report.effective_bytes_read, old_pages_streamed: report.old_pages_streamed, raw_pages_streamed: report.raw_pages_streamed, parity_match: parity_match,
    }
}
fn wire_from_attention_report(report: attention.AttentionReport, parity_match: i32) -> str {
    return report_wire(report.policy_name, report.prompt_tokens, report.decode_tokens, report.used_pages, report.target_token, report.target_layer, report.attn_sum_x1000, report.output_sum_x1000, report.top_page, report.top_score_x1000, report.effective_bytes_read, report.old_pages_streamed, report.raw_pages_streamed, parity_match,)
}
fn report_json_from_wire(wire: str) -> str {
    return str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat(str.concat("{\"policy\":", json.str(str_field(wire, 0))), str.concat(",\"prompt_tokens\":", frame_value_at(wire, 1))), str.concat(",\"decode_tokens\":", frame_value_at(wire, 2))), str.concat(",\"used_pages\":", frame_value_at(wire, 3))), str.concat(",\"target_token\":", frame_value_at(wire, 4))), str.concat(",\"target_layer\":", frame_value_at(wire, 5))), str.concat(",\"attn_sum_x1000\":", frame_value_at(wire, 6))), str.concat(",\"output_sum_x1000\":", frame_value_at(wire, 7))), str.concat(",\"top_page\":", frame_value_at(wire, 8))), str.concat(",\"top_score_x1000\":", frame_value_at(wire, 9))), str.concat(",\"effective_bytes_read\":", frame_value_at(wire, 10))), str.concat(",\"old_pages_streamed\":", frame_value_at(wire, 11))), str.concat(",\"raw_pages_streamed\":", frame_value_at(wire, 12))), str.concat(str.concat(",\"parity_match\":", frame_value_at(wire, 13)), "}"))
}
fn parity_report(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState, prompt_token_ids_wire: str, decode_token_ids_wire: str) -> i32 {
    trace_line("attention_parity_begin") let full_cfg = runtime.session.config(cfg.model_dir, cfg.page_tokens, cfg.hot_budget_pct, state.prompt_tokens, state.decode_tokens, "full_kv") let paged_cfg = runtime.session.config(cfg.model_dir, cfg.page_tokens, cfg.hot_budget_pct, state.prompt_tokens, state.decode_tokens, "paged_full_kv") let full = attention.report_wire_for(shape, full_cfg, runtime.session.state(shape, full_cfg), prompt_token_ids_wire, decode_token_ids_wire) let paged = attention.report_wire_for(shape, paged_cfg, runtime.session.state(shape, paged_cfg), prompt_token_ids_wire, decode_token_ids_wire) trace_line("attention_parity_done") if attention.wire_i32(full, 6) == attention.wire_i32(paged, 6) {
        if attention.wire_i32(full, 7) == attention.wire_i32(paged, 7) {
            if attention.wire_i32(full, 8) == attention.wire_i32(paged, 8) {
                if attention.wire_i32(full, 9) == attention.wire_i32(paged, 9) {
                    if attention.wire_i32(full, 10) == attention.wire_i32(paged, 10) {
                        if attention.wire_i32(full, 11) == attention.wire_i32(paged, 11) {
                            if attention.wire_i32(full, 12) == attention.wire_i32(paged, 12) {
                                return 1
                            }
                        }
                    }
                }
            }
        }
    }
    return 0
}
fn report_with_parity_wire(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState, prompt_token_ids_wire: str, decode_token_ids_wire: str, parity_match: i32) -> str {
    return report_with_parity_wire_from_manager(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire, runtime.session.manager_of(shape, cfg.policy_name, state), parity_match)
}
fn metrics_wire_from_manager(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState, prompt_token_ids_wire: str, decode_token_ids_wire: str, manager: runtime.block_manager.ManagedSession) -> str {
    let parity_match = if parity_enabled() == 1 {
        parity_report(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire)
    } else {
        1
    }
    let layer_id = attention.choose_target_layer(shape)
    let table_refs_wire = runtime.block_manager.table_segment(manager.layer_tables_wire, layer_id)
    let mut effective_bytes_read = 0
    let mut old_pages_streamed = 0
    let mut raw_pages_streamed = 0
    let mut logical_block_id = 0
    while logical_block_id < kv.logical_block_table.refs_len(table_refs_wire) {
        let physical_block_id = kv.logical_block_table.ref_physical_block_id_at_from_refs(table_refs_wire, logical_block_id)
        let block_wire = kv.physical_block_pool.block_segment(manager.pool_blocks_wire, physical_block_id)
        let k_precision_name = kv.physical_block_pool.block_k_precision_name_from_wire(block_wire)
        if k_precision_name != "dropped" {
            if cfg.policy_name == "full_kv" || cfg.policy_name == "paged_full_kv" {
                effective_bytes_read = effective_bytes_read + kv.physical_block_pool.raw_equivalent_bytes_from_wire(shape, block_wire)
                raw_pages_streamed = raw_pages_streamed + 1
            } else {
                effective_bytes_read = effective_bytes_read + kv.physical_block_pool.encoded_bytes_from_wire(shape, block_wire)
                if kv.physical_block_pool.block_is_hot_from_wire(block_wire) == 1 {
                    raw_pages_streamed = raw_pages_streamed + 1
                } else {
                    old_pages_streamed = old_pages_streamed + 1
                }
            }
        }
        logical_block_id = logical_block_id + 1
    }
    let _state = state
    return metrics_wire(effective_bytes_read, old_pages_streamed, raw_pages_streamed, parity_match)
}
fn report_with_parity_wire_from_manager(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState, prompt_token_ids_wire: str, decode_token_ids_wire: str, manager: runtime.block_manager.ManagedSession, parity_match: i32) -> str {
    trace_line("attention_report_begin") let report = attention.report_wire_for_with_manager(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire, manager) trace_line("attention_report_done") return report_wire(attention.wire_str(report, 0), attention.wire_i32(report, 1), attention.wire_i32(report, 2), attention.wire_i32(report, 3), attention.wire_i32(report, 4), attention.wire_i32(report, 5), attention.wire_i32(report, 6), attention.wire_i32(report, 7), attention.wire_i32(report, 8), attention.wire_i32(report, 9), attention.wire_i32(report, 10), attention.wire_i32(report, 11), attention.wire_i32(report, 12), parity_match)
}
fn report(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState) -> AttentionRuntimeReport {
    return from_wire(report_with_parity_wire(shape, cfg, state, runtime.session.placeholder_sequence_wire(state.prompt_tokens), runtime.session.placeholder_sequence_range_wire(state.prompt_tokens, state.decode_tokens), 0))
}
fn with_parity(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState, prompt_token_ids_wire: str, decode_token_ids_wire: str) -> AttentionRuntimeReport {
    return from_wire(with_parity_wire(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire))
}
fn with_parity_wire(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState, prompt_token_ids_wire: str, decode_token_ids_wire: str) -> str {
    if parity_enabled() == 1 {
        return report_with_parity_wire(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire, parity_report(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire))
    }
    return report_with_parity_wire(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire, 1)
}
fn with_parity_json(shape: model.EngineShape, cfg: runtime.session.SessionConfig, state: runtime.session.SessionState, prompt_token_ids_wire: str, decode_token_ids_wire: str) -> str {
    return report_json_from_wire(with_parity_wire(shape, cfg, state, prompt_token_ids_wire, decode_token_ids_wire))
}
