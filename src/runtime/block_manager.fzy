            should_remap = 1
        }
        if current.v_precision_name != desired_v {
            should_remap = 1
        }
        if current.role_name != desired_role {
            should_remap = 1
        }
        if current.is_hot != logical_block_is_hot(manager, logical_block_id) {
            should_remap = 1
        }
        if should_remap == 1 {
            let replacement = kv.physical_block_pool.allocate(pool, layer_id, current.start_token, current.token_count, desired_k, desired_v, desired_role, logical_block_is_hot(manager, logical_block_id), 0, if logical_block_is_hot(manager, logical_block_id) == 1 {
                0
            } else {
                1
