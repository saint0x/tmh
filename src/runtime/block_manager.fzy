fn append_token(shape: model.EngineShape, hot_budget_pct: i32, policy_name: str, manager: ManagedSession, tail_block_tokens: i32) -> AppendResult {
    if manager.used_blocks <= 0 {
        let built = build_session(shape, hot_budget_pct, policy_name, 1, 1) return AppendResult {
            manager: built, used_blocks: 1, tail_block_tokens: 1,
        }
    }
    if tail_block_tokens < shape.page_tokens {
        if trace_enabled() == 1 {
            discard term.write(str.concat(str.concat(str.concat("FPA_TRACE_APPEND tail_update used_blocks=", str.from_i32(manager.used_blocks)), str.concat(" tail_block_tokens=", str.from_i32(tail_block_tokens))), "\n"))
        }
        let tail_block_id = manager.used_blocks - 1 let next_tokens = tail_block_tokens + 1 let mut pool = pool_of(manager) let mut tables = manager.layer_tables_wire let mut copy_on_write_count = manager.copy_on_write_count let mut layer_id = 0 while layer_id < shape.layer_count {
            if trace_enabled() == 1 {
                discard term.write(str.concat(str.concat("FPA_TRACE_APPEND layer=", str.from_i32(layer_id)), "\n"))
            }
            let table_manager = ManagedSession {
                pool_blocks_wire: pool.blocks_wire, pool_free_ids_wire: pool.free_ids_wire, pool_next_block_id: pool.next_block_id, pool_live_blocks: pool.live_blocks, pool_total_allocations: pool.total_allocations, pool_total_frees: pool.total_frees, layer_tables_wire: tables, used_blocks: manager.used_blocks, hot_blocks: manager.hot_blocks, recent_start_block: manager.recent_start_block, block_remaps: manager.block_remaps, copy_on_write_count: copy_on_write_count,
            }
            let table = table_at(table_manager, layer_id) let detached = runtime.cow.ensure_private_mapping(pool, table, tail_block_id) pool = detached.pool copy_on_write_count = copy_on_write_count + detached.copied let reference = kv.logical_block_table.ref_at(detached.table, tail_block_id) pool = kv.physical_block_pool.set_token_count(pool, reference.physical_block_id, next_tokens) let updated_table = kv.logical_block_table.replace_mapping(detached.table, tail_block_id, reference.physical_block_id, next_tokens) let update_manager = ManagedSession {
                pool_blocks_wire: pool.blocks_wire, pool_free_ids_wire: pool.free_ids_wire, pool_next_block_id: pool.next_block_id, pool_live_blocks: pool.live_blocks, pool_total_allocations: pool.total_allocations, pool_total_frees: pool.total_frees, layer_tables_wire: tables, used_blocks: manager.used_blocks, hot_blocks: manager.hot_blocks, recent_start_block: manager.recent_start_block, block_remaps: manager.block_remaps, copy_on_write_count: copy_on_write_count,
            }
