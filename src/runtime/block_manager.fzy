        pool_blocks_wire: pool.blocks_wire, pool_free_ids_wire: pool.free_ids_wire, pool_next_block_id: pool.next_block_id, pool_live_blocks: pool.live_blocks, pool_total_allocations: pool.total_allocations, pool_total_frees: pool.total_frees, layer_tables_wire: layer_tables_wire, used_blocks: manager.used_blocks, hot_blocks: manager.hot_blocks, recent_start_block: manager.recent_start_block, block_remaps: manager.block_remaps + remapped, copy_on_write_count: manager.copy_on_write_count,
