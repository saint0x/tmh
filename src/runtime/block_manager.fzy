fn build_session_live(shape: model.EngineShape, hot_budget_pct: i32, policy_name: str, used_blocks: i32, tail_block_tokens: i32) -> ManagedSession {
    let runtime_cfg = model.artifacts.runtime_config_for_policy_name_active(shape, hot_budget_pct, policy_name, used_blocks) let recent_start_block = if runtime_cfg.hot_pages >= used_blocks {
        0
    } else {
        used_blocks - runtime_cfg.hot_pages
    }
    let mut pool = kv.physical_block_pool.create() let mut layer_tables_wire = "" let layout = ManagedSession {
        pool_blocks_wire: "", pool_free_ids_wire: "", pool_next_block_id: 0, pool_live_blocks: 0, pool_total_allocations: 0, pool_total_frees: 0, layer_tables_wire: "", used_blocks: used_blocks, hot_blocks: runtime_cfg.hot_pages, recent_start_block: recent_start_block, block_remaps: 0, copy_on_write_count: 0,
    }
    let mut layer_id = 0 while layer_id < shape.layer_count {
        let mut table = kv.logical_block_table.create(0, layer_id) let mut logical_block_id = 0 while logical_block_id < used_blocks {
            let token_count = if logical_block_id < used_blocks - 1 {
                shape.page_tokens
            } else {
                tail_block_tokens
            }
            let alloc = kv.physical_block_pool.allocate(pool, layer_id, logical_block_id * shape.page_tokens, token_count, "raw", "raw", desired_role_name(shape, layer_id, logical_block_id, layout), logical_block_is_hot(layout, logical_block_id), 0, 0, 0,) pool = kv.physical_block_pool.increment_refcount(alloc.pool, alloc.physical_block_id) table = kv.logical_block_table.append_mapping(table, alloc.physical_block_id, token_count) logical_block_id = logical_block_id + 1
        }
        layer_tables_wire = frame_push(layer_tables_wire, table_json(table)) layer_id = layer_id + 1
    }
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat(str.concat("FPA_TRACE_BUILD_LIVE local_pool_blocks_len=", str.from_i32(kv.physical_block_pool.blocks_len(pool.blocks_wire))), str.concat(" local_pool_wire_len=", str.from_i32(str.len(pool.blocks_wire)))), "\n"))
    }
    let mut manager = ManagedSession {
        pool_blocks_wire: pool.blocks_wire, pool_free_ids_wire: pool.free_ids_wire, pool_next_block_id: pool.next_block_id, pool_live_blocks: pool.live_blocks, pool_total_allocations: pool.total_allocations, pool_total_frees: pool.total_frees, layer_tables_wire: layer_tables_wire, used_blocks: used_blocks, hot_blocks: runtime_cfg.hot_pages, recent_start_block: recent_start_block, block_remaps: 0, copy_on_write_count: 0,
    }
    if policy_requires_remap(policy_name) == 0 {
        return manager
    }
    if manager.used_blocks <= manager.hot_blocks {
        return manager
    }
    if trace_enabled() == 1 {
        discard term.write(str.concat(str.concat(str.concat("FPA_TRACE_BUILD_LIVE manager_pool_blocks_len=", str.from_i32(kv.physical_block_pool.blocks_len(manager.pool_blocks_wire))), str.concat(" manager_pool_wire_len=", str.from_i32(str.len(manager.pool_blocks_wire)))), "\n"))
    }
    layer_id = 0 while layer_id < shape.layer_count {
        let demoted = demote_layer(shape, policy_name, layer_id, manager) let pooled = with_pool(manager, demoted.pool) let remapped = ManagedSession {
            pool_blocks_wire: pooled.pool_blocks_wire, pool_free_ids_wire: pooled.pool_free_ids_wire, pool_next_block_id: pooled.pool_next_block_id, pool_live_blocks: pooled.pool_live_blocks, pool_total_allocations: pooled.pool_total_allocations, pool_total_frees: pooled.pool_total_frees, layer_tables_wire: pooled.layer_tables_wire, used_blocks: pooled.used_blocks, hot_blocks: pooled.hot_blocks, recent_start_block: pooled.recent_start_block, block_remaps: manager.block_remaps + demoted.remapped, copy_on_write_count: pooled.copy_on_write_count,
        }
        manager = with_table(remapped, layer_id, demoted.table) layer_id = layer_id + 1
    }
    return manager
}
