fn demote_layer(shape: model.EngineShape, policy_name: str, layer_id: i32, manager: ManagedSession) -> DemotionResult {
    let mut pool = pool_of(manager) let mut table = table_at(manager, layer_id) let mut remapped = 0 let mut logical_block_id = 0 while logical_block_id < kv.logical_block_table.len(table) {
        if trace_enabled() == 1 {
