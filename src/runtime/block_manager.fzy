    }
    let updated_manager = ManagedSession {
        pool_blocks_wire: pool.blocks_wire, pool_free_ids_wire: pool.free_ids_wire, pool_next_block_id: pool.next_block_id, pool_live_blocks: pool.live_blocks, pool_total_allocations: pool.total_allocations, pool_total_frees: pool.total_frees, layer_tables_wire: tables, used_blocks: next_used_blocks, hot_blocks: seeded.hot_blocks, recent_start_block: seeded.recent_start_block, block_remaps: manager.block_remaps, copy_on_write_count: manager.copy_on_write_count,
    }
    let refreshed = refresh_layout(shape, hot_budget_pct, policy_name, updated_manager) return AppendResult {
        manager: refreshed, used_blocks: next_used_blocks, tail_block_tokens: 1,
    }
}
fn append_token_wire(shape: model.EngineShape, hot_budget_pct: i32, policy_name: str, manager: ManagedSession, tail_block_tokens: i32) -> str {
    return append_wire(append_token(shape, hot_budget_pct, policy_name, manager, tail_block_tokens))
}
fn table_count(wire: str) -> i32 {
    if wire == "" {
        return 0
    }
    let mut count = 0 let mut idx = 0 while idx < str.len(wire) {
        let sep = frame_sep(wire, idx) if sep < 0 {
            return count
        }
        let size = model.artifacts.parse_i32(str.slice(wire, idx, sep)) idx = sep + 1 + size count = count + 1
    }
    return count
}
fn table_segment(wire: str, position: i32) -> str {
    return frame_value_at(wire, position)
}
