use core.env;
use model;
struct GenerationConfig {
    max_new_tokens: i32, eos_token_id: i32, stop_on_eos: i32, temperature_milli: i32, vocab_size: i32,
}
fn config(max_new_tokens: i32, eos_token_id: i32, stop_on_eos: i32, temperature_milli: i32, vocab_size: i32) -> GenerationConfig {
    return GenerationConfig {
        max_new_tokens: max_new_tokens, eos_token_id: eos_token_id, stop_on_eos: stop_on_eos, temperature_milli: temperature_milli, vocab_size: vocab_size,
    }
}
fn from_env(model_dir: str, page_tokens: i32, hot_budget_pct: i32) -> GenerationConfig {
    let artifact = model.artifacts.inspect_model_dir(model_dir, page_tokens, hot_budget_pct) let max_new_tokens = if env.get("FPA_MAX_NEW_TOKENS") == "" {
        16
    } else {
        model.artifacts.parse_i32(env.get("FPA_MAX_NEW_TOKENS"))
    }
    let eos_token_id = if env.get("FPA_EOS_TOKEN_ID") == "" {
        0
    } else {
        model.artifacts.parse_i32(env.get("FPA_EOS_TOKEN_ID"))
    }
    let stop_on_eos = if env.get("FPA_STOP_ON_EOS") == "" {
        0
    } else {
        model.artifacts.parse_i32(env.get("FPA_STOP_ON_EOS"))
    }
    return config(max_new_tokens, eos_token_id, stop_on_eos, 0, safe_vocab_size(artifact.vocab_size))
}
fn safe_vocab_size(vocab_size: i32) -> i32 {
    if vocab_size <= 0 {
        return 4096
    }
    return vocab_size
}
