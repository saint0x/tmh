}
test "det_paged_full_attention_matches_full" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "fidelity_paged_kv") let state = runtime.session.state(shape, cfg) if runtime.attention_core.parity_report(shape, cfg, state, runtime.session.placeholder_sequence_wire(state.prompt_tokens), runtime.session.placeholder_sequence_range_wire(state.prompt_tokens, state.decode_tokens)) != 1 {
        checkpoint()
    }
}
test "det_block_manager_build_session_keeps_hot_tail_raw" {
    let shape = model.default_shape() let manager = runtime.block_manager.build_session(shape, 25, "fidelity_paged_kv", 1, 22) let pool = runtime.block_manager.pool_of(manager) let table = runtime.block_manager.table_at(manager, shape.layer_count - 1) let reference = kv.logical_block_table.ref_at(table, 0) let block = kv.physical_block_pool.block_at(pool, reference.physical_block_id) if kv.logical_block_table.len(table) != 1 {
        checkpoint()
    }
    if reference.token_count != 22 {
        checkpoint()
    }
    if kv.physical_block_pool.k_precision_of(block) != kv.kv_page.Precision::Raw {
        checkpoint()
    }
    if kv.physical_block_pool.v_precision_of(block) != kv.kv_page.Precision::Raw {
        checkpoint()
    }
    if block.is_hot != 1 {
        checkpoint()
    }
}
