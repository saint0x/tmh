use bench;
use kv;
use model;
use runtime;
test "det_parse_hf_decoder_config" {
    let raw = "{\"hidden_size\":1536,\"num_hidden_layers\":28,\"num_attention_heads\":12,\"num_key_value_heads\":2,\"max_position_embeddings\":32768}"
    let shape = model.artifacts.shape_from_hf_config(raw, 64)
    if shape.layer_count != 28 {
        checkpoint()
    }
    if shape.head_count != 12 {
        checkpoint()
    }
    if shape.head_dim != 128 {
        checkpoint()
    }
    if shape.context_tokens != 32768 {
        checkpoint()
    }
}
test "det_logical_block_table_wire_roundtrip" {
    let table = kv.logical_block_table.append_mapping(kv.logical_block_table.append_mapping(kv.logical_block_table.create(3, 4), 9, 64), 12, 22,) let decoded = kv.logical_block_table.from_wire(kv.logical_block_table.wire(table)) if decoded.seq_id != 3 {
        checkpoint()
    }
    if decoded.layer_id != 4 {
        checkpoint()
    }
    if kv.logical_block_table.len(decoded) != 2 {
        checkpoint()
    }
    if kv.logical_block_table.ref_at(decoded, 0).physical_block_id != 9 {
        checkpoint()
    }
    if kv.logical_block_table.ref_at(decoded, 1).token_count != 22 {
        checkpoint()
    }
}
test "det_physical_block_wire_roundtrip" {
    let pool = kv.physical_block_pool.increment_refcount(kv.physical_block_pool.allocate(kv.physical_block_pool.create(), 2, 128, 22, "raw", "int8", "recent", 1, 0, 0, 7,).pool, 0,) let block = kv.physical_block_pool.block_at(pool, 0) if block.layer_id != 2 {
        checkpoint()
    }
    if block.start_token != 128 {
        checkpoint()
    }
    if block.token_count != 22 {
        checkpoint()
    }
    if kv.physical_block_pool.k_precision_of(block) != kv.kv_page.Precision::Raw {
        checkpoint()
    }
    if kv.physical_block_pool.v_precision_of(block) != kv.kv_page.Precision::Int8 {
        checkpoint()
    }
    if block.is_hot != 1 {
        checkpoint()
    }
}
test "det_physical_block_pool_tracks_multiple_framed_blocks" {
    let alloc0 = kv.physical_block_pool.allocate(kv.physical_block_pool.create(), 0, 0, 64, "raw", "raw", "recent", 1, 0, 0, 0,) let alloc1 = kv.physical_block_pool.allocate(kv.physical_block_pool.increment_refcount(alloc0.pool, alloc0.physical_block_id), 1, 64, 32, "int8", "int4", "old", 0, 0, 1, 2,) let pool = kv.physical_block_pool.increment_refcount(alloc1.pool, alloc1.physical_block_id) let left = kv.physical_block_pool.block_at(pool, 0) let right = kv.physical_block_pool.block_at(pool, 1) if kv.physical_block_pool.blocks_len(pool.blocks_wire) != 2 {
        checkpoint()
    }
    if left.token_count != 64 {
        checkpoint()
    }
    if right.layer_id != 1 {
        checkpoint()
    }
    if kv.physical_block_pool.k_precision_of(right) != kv.kv_page.Precision::Int8 {
        checkpoint()
    }
    if kv.physical_block_pool.v_precision_of(right) != kv.kv_page.Precision::Int4 {
        checkpoint()
    }
}
test "det_physical_block_pool_reuses_freed_ids" {
    let alloc = kv.physical_block_pool.allocate(kv.physical_block_pool.create(), 0, 0, 64, "raw", "raw", "recent", 1, 0, 0, 0,) let retained = kv.physical_block_pool.increment_refcount(alloc.pool, alloc.physical_block_id) let freed = kv.physical_block_pool.decrement_refcount(retained, alloc.physical_block_id) let reused = kv.physical_block_pool.allocate(freed, 3, 128, 17, "int8", "raw", "old", 0, 0, 0, 4,) let pool = kv.physical_block_pool.increment_refcount(reused.pool, reused.physical_block_id) let block = kv.physical_block_pool.block_at(pool, 0) if reused.physical_block_id != 0 {
        checkpoint()
    }
    if kv.physical_block_pool.free_ids_len(pool.free_ids_wire) != 0 {
        checkpoint()
    }
    if block.layer_id != 3 {
        checkpoint()
    }
    if block.token_count != 17 {
        checkpoint()
    }
    if kv.physical_block_pool.k_precision_of(block) != kv.kv_page.Precision::Int8 {
        checkpoint()
    }
}
test "det_fidelity_old_v_is_more_compressed_than_quantized_old" {
    let shape = model.default_shape() let used_blocks = model.total_pages(shape) let fidelity_mem = runtime.residency.memory_report(shape, runtime.block_manager.build_session(shape, 25, "fidelity_paged_kv", used_blocks, shape.page_tokens)) let quant_mem = runtime.residency.memory_report(shape, runtime.block_manager.build_session(shape, 25, "quantized_old_kv", used_blocks, shape.page_tokens)) if fidelity_mem.warm_bytes >= quant_mem.warm_bytes {
        checkpoint()
    }
}
test "det_recent_only_drops_old_pages" {
    let shape = model.default_shape() let manager = runtime.block_manager.build_session(shape, 25, "recent_only", 2, shape.page_tokens) let pool = runtime.block_manager.pool_of(manager) let table = runtime.block_manager.table_at(manager, 0) let reference = kv.logical_block_table.ref_at(table, 0) let block = kv.physical_block_pool.block_at(pool, reference.physical_block_id) if kv.physical_block_pool.k_precision_of(block) != kv.kv_page.Precision::Dropped {
        checkpoint()
    }
    if kv.physical_block_pool.v_precision_of(block) != kv.kv_page.Precision::Dropped {
        checkpoint()
    }
}
test "det_session_state_tracks_prefill_and_decode_pages" {
    let shape = model.engine_shape(5, 4, 8, 64, 512, 3) let cfg = runtime.session.config("test-model", 64, 25, 70, 10, "fidelity_paged_kv") let state = runtime.session.state(shape, cfg) if state.prefill_pages != 2 {
        checkpoint()
    }
    if state.decode_pages != 0 {
        checkpoint()
    }
    if state.used_pages != 2 {
        checkpoint()
    }
    if state.tail_page_tokens != 16 {
        checkpoint()
    }
    if runtime.session.manager_of(shape, cfg.policy_name, state).used_blocks != 2 {
        checkpoint()
    }
}
test "det_live_session_advance_grows_tail_before_allocating_new_page" {
    let shape = model.engine_shape(5, 4, 8, 64, 512, 3) let cfg = runtime.session.config("test-model", 64, 25, 70, 10, "fidelity_paged_kv") let initial = runtime.session.begin(shape, cfg) let next = runtime.session.advance(shape, cfg, initial) if initial.used_pages != 2 {
        checkpoint()
    }
    if next.used_pages != 2 {
        checkpoint()
    }
    if next.tail_page_tokens != 7 {
        checkpoint()
    }
    if next.decode_tokens != 1 {
        checkpoint()
    }
}
test "det_live_session_advance_allocates_new_page_on_tail_overflow" {
    let shape = model.engine_shape(5, 4, 8, 64, 512, 3) let cfg = runtime.session.config("test-model", 64, 25, 128, 10, "fidelity_paged_kv") let initial = runtime.session.begin(shape, cfg) let next = runtime.session.advance(shape, cfg, initial) if initial.used_pages != 2 {
        checkpoint()
    }
    if next.used_pages != 3 {
        checkpoint()
    }
    if next.tail_page_tokens != 1 {
        checkpoint()
    }
    if next.decode_pages != 1 {
        checkpoint()
    }
}
test "det_session_hot_window_uses_active_pages" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 96, 32, "fidelity_paged_kv") let state = runtime.session.state(shape, cfg) let manager = runtime.session.manager_of(shape, cfg.policy_name, state) let pool = runtime.block_manager.pool_of(manager) let table = runtime.block_manager.table_at(manager, 0) let cold_ref = kv.logical_block_table.ref_at(table, 0) let hot_ref = kv.logical_block_table.ref_at(table, state.used_pages - 1) let cold_block = kv.physical_block_pool.block_at(pool, cold_ref.physical_block_id) let hot_block = kv.physical_block_pool.block_at(pool, hot_ref.physical_block_id) if cold_block.is_hot != 0 {
        checkpoint()
    }
    if hot_block.is_hot != 1 {
        checkpoint()
    }
}
test "det_residency_report_marks_late_layer_v_as_int8" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "fidelity_paged_kv") let state = runtime.session.state(shape, cfg) let report = runtime.residency.report(shape, cfg, state) if report.last_page_v_precision != "raw" {
        checkpoint()
    }
    if report.hot_layer_pages <= 0 {
        checkpoint()
    }
    if report.block_remap_count <= 0 {
        checkpoint()
    }
}
test "det_tmh_plan_compiles_prompt_anchor_for_fidelity" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "fidelity_paged_kv") let state = runtime.session.state(shape, cfg) let compiled = runtime.tmh_plan.compile(shape, cfg.policy_name, state.used_pages, state.prefill_pages, state.recent_start_page) let first = runtime.tmh_plan.range_for(compiled, 0, 0) if runtime.tmh_plan.range_count(compiled.ranges_wire) <= 0 {
        checkpoint()
    }
    if first.semantic_class != "prompt_anchor" {
        checkpoint()
    }
    if first.pin != 1 {
        checkpoint()
    }
    if first.k_precision_name != "raw" {
        checkpoint()
    }
    if first.v_precision_name != "raw" {
        checkpoint()
    }
    if first.residency_tier != "pinned" {
        checkpoint()
    }
}
test "det_session_manager_executes_prompt_anchor_plan" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "fidelity_paged_kv") let state = runtime.session.state(shape, cfg) let manager = runtime.session.manager_of(shape, cfg.policy_name, state) let pool = runtime.block_manager.pool_of(manager) let table = runtime.block_manager.table_at(manager, 0) let reference = kv.logical_block_table.ref_at(table, 0) let block = kv.physical_block_pool.block_at(pool, reference.physical_block_id) if block.role_name != "pinned" {
        checkpoint()
    }
    if block.k_precision_name != "raw" {
        checkpoint()
    }
    if block.v_precision_name != "raw" {
        checkpoint()
    }
    if block.is_hot != 0 {
        checkpoint()
    }
}
test "det_quantized_old_session_manager_keeps_uniform_old_compression" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "quantized_old_kv") let state = runtime.session.state(shape, cfg) let manager = runtime.session.manager_of(shape, cfg.policy_name, state) let pool = runtime.block_manager.pool_of(manager) let table = runtime.block_manager.table_at(manager, 0) let reference = kv.logical_block_table.ref_at(table, 0) let block = kv.physical_block_pool.block_at(pool, reference.physical_block_id) if block.role_name == "pinned" {
        checkpoint()
    }
    if block.k_precision_name != "int8" {
        checkpoint()
    }
    if block.v_precision_name != "int8" {
        checkpoint()
    }
}
test "det_residency_report_emits_mixed_fidelity_precision_census" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "fidelity_paged_kv") let state = runtime.session.state(shape, cfg) let report = runtime.residency.report(shape, cfg, state) if report.raw_k_pages <= 0 {
        checkpoint()
    }
    if report.int8_k_pages <= 0 {
        checkpoint()
    }
    if report.int4_k_pages != 0 {
        checkpoint()
    }
    if report.raw_v_pages <= 0 {
        checkpoint()
    }
    if report.int8_v_pages <= 0 {
        checkpoint()
    }
    if report.int4_v_pages <= 0 {
        checkpoint()
    }
    if report.dropped_k_pages != 0 {
        checkpoint()
    }
    if report.dropped_v_pages != 0 {
        checkpoint()
    }
}
test "det_quantized_old_residency_keeps_v_at_int8_only" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "quantized_old_kv") let state = runtime.session.state(shape, cfg) let report = runtime.residency.report(shape, cfg, state) if report.int8_k_pages <= 0 {
        checkpoint()
    }
    if report.int4_k_pages != 0 {
        checkpoint()
    }
    if report.int8_v_pages <= 0 {
        checkpoint()
    }
    if report.int4_v_pages != 0 {
        checkpoint()
    }
}
test "det_recent_only_residency_marks_dropped_precision_census" {
    let shape = model.default_shape() let cfg = runtime.session.config("test-model", 64, 25, 192, 64, "recent_only") let state = runtime.session.state(shape, cfg) let report = runtime.residency.report(shape, cfg, state) if report.dropped_k_pages <= 0 {
        checkpoint()
    }
    if report.dropped_v_pages <= 0 {
        checkpoint()
